---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BlogNav from '../../components/BlogNav.astro';
import BlogCard from '../../components/BlogCard.astro';
import Footer from '../../components/Footer.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

// Group posts by album for sidebar
const byAlbum: Record<string, typeof posts> = {};
for (const post of posts) {
  const album = post.data.album;
  if (!byAlbum[album]) byAlbum[album] = [];
  byAlbum[album].push(post);
}

// Album display order (most recent first)
const albumOrder = [
  'ARIRANG (2026)',
  'BE (2020)',
  'You Never Walk Alone (2017)',
  'Love Yourself: Tear (2018)',
];
---

<Layout
  title="El diario de una ARMY — Blog | Purple Heart Journal"
  description="Canciones de BTS analizadas como espejos de autoconocimiento. Reflexiones, prompts de journaling y una invitación a escribir lo que sientes."
>
  <BlogNav />

  <!-- Header -->
  <header class="blog-header">
    <div class="header-inner">
      <p class="header-label">El diario de una ARMY</p>
      <h1 class="header-title">Canciones que nos enseñan<br />a conocernos</h1>
      <p class="header-desc">
        No somos un medio de noticias de BTS. Somos ARMY que escribe lo que siente
        y que encuentra en las canciones el espejo perfecto para hacerlo.
      </p>
    </div>
  </header>

  <!-- Mobile index strip (visible only <900px) -->
  <div class="blog-mobile-index">
    {posts.map(post => (
      <a href={`/blog/${post.id}`} class="mobile-index-tag">{post.data.song}</a>
    ))}
  </div>

  <!-- Layout: sidebar + content -->
  <div class="blog-layout">

    <!-- Sidebar editorial -->
    <aside class="blog-sidebar">
      <div class="sidebar-inner">
        <p class="sidebar-heading">Índice</p>
        {albumOrder.map(album => byAlbum[album] && (
          <div class="sidebar-group">
            <p class="sidebar-album">{album}</p>
            <ul class="sidebar-list">
              {byAlbum[album].map(post => (
                <li>
                  <a href={`/blog/${post.id}`} class="sidebar-link">
                    <span class="sidebar-song">{post.data.song}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </aside>

    <!-- Main articles -->
    <main class="blog-main">
      {posts.length === 0 ? (
        <p class="empty-state">Próximamente — mientras tanto, escribe lo que sientes. 💜</p>
      ) : (
        <div class="posts-grid">
          {posts.map(post => (
            <BlogCard
              slug={post.id}
              title={post.data.title}
              song={post.data.song}
              album={post.data.album}
              excerpt={post.data.excerpt}
              date={post.data.date}
              tags={post.data.tags}
            />
          ))}
        </div>
      )}
    </main>

  </div>

  <!-- CTA -->
  <section class="blog-cta">
    <div class="max-w-2xl mx-auto text-center px-5">
      <p class="cta-label">¿Quieres escribir con BTS de fondo?</p>
      <h2 class="cta-title">El journal que habla en nuestro idioma</h2>
      <p class="cta-desc">
        85+ prompts de journaling guiados por 35 canciones de BTS.<br />
        Para ARMY que escribe entre canciones.
      </p>
      <a
        href="https://pay.hotmart.com/P104306248S"
        class="btn-primary inline-block mt-6"
        target="_blank"
        rel="noopener noreferrer"
      >
        Conoce el journal 💜
      </a>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .blog-header {
    background: linear-gradient(135deg, #1A0A2E 0%, #5B2C8E 60%, #9B4DCA 100%);
    padding: 3rem 1.25rem 4rem;
    position: relative;
    overflow: hidden;
  }

  .blog-header::before {
    content: '';
    position: absolute;
    top: -40%;
    right: -20%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(199, 125, 255, 0.15) 0%, transparent 70%);
    pointer-events: none;
  }

  .header-inner {
    max-width: 56rem;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .header-label {
    font-family: var(--font-accent);
    font-size: 1.5rem;
    color: var(--color-purple-heart);
    margin-bottom: 0.75rem;
  }

  .header-title {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 2.25rem;
    line-height: 1.2;
    color: var(--color-white-glow);
    margin-bottom: 1.25rem;
  }

  @media (min-width: 768px) {
    .blog-header { padding: 4rem 1.25rem 5rem; }
    .header-title { font-size: 3rem; }
  }

  .header-desc {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.65;
    color: rgba(224, 208, 240, 0.8);
    max-width: 42rem;
  }

  /* ── Layout: sidebar + main ── */
  .blog-layout {
    display: flex;
    align-items: flex-start;
    background: var(--color-white-glow);
    min-height: 60vh;
  }

  /* ── Sidebar ── */
  .blog-sidebar {
    display: none; /* hidden on mobile */
    width: 220px;
    flex-shrink: 0;
    border-right: 1px solid var(--color-soft-lilac);
    background: var(--color-white-glow);
  }

  @media (min-width: 900px) {
    .blog-sidebar {
      display: block;
      position: sticky;
      top: 56px; /* below BlogNav */
      max-height: calc(100vh - 56px);
      overflow-y: auto;
    }
  }

  @media (min-width: 1100px) {
    .blog-sidebar { width: 260px; }
  }

  .sidebar-inner {
    padding: 2.5rem 1.5rem 3rem;
  }

  .sidebar-heading {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-purple-vibrant);
    margin-bottom: 1.75rem;
  }

  .sidebar-group {
    margin-bottom: 1.75rem;
  }

  .sidebar-album {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(107, 91, 123, 0.6);
    margin-bottom: 0.625rem;
    padding-bottom: 0.375rem;
    border-bottom: 1px solid rgba(224, 208, 240, 0.6);
  }

  .sidebar-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .sidebar-link {
    display: block;
    text-decoration: none;
    padding: 0.3125rem 0.625rem;
    border-radius: 0.375rem;
    transition: background 0.15s ease, color 0.15s ease;
    cursor: pointer;
  }

  .sidebar-link:hover {
    background: rgba(199, 125, 255, 0.1);
  }

  .sidebar-link:hover .sidebar-song {
    color: var(--color-purple-vibrant);
  }

  .sidebar-song {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 0.9375rem;
    color: var(--color-text-deep);
    line-height: 1.4;
    transition: color 0.15s ease;
  }

  /* Mobile index strip */
  .blog-mobile-index {
    display: flex;
    overflow-x: auto;
    gap: 0.5rem;
    padding: 0.875rem 1.25rem;
    background: var(--color-lavender-mist);
    border-bottom: 1px solid var(--color-soft-lilac);
    scrollbar-width: none;
  }

  .blog-mobile-index::-webkit-scrollbar { display: none; }

  @media (min-width: 900px) {
    .blog-mobile-index { display: none; }
  }

  .mobile-index-tag {
    flex-shrink: 0;
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 0.875rem;
    color: var(--color-text-deep);
    text-decoration: none;
    background: var(--color-white-glow);
    border: 1px solid var(--color-soft-lilac);
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    white-space: nowrap;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .mobile-index-tag:hover {
    border-color: var(--color-purple-heart);
    color: var(--color-purple-vibrant);
  }

  /* ── Main ── */
  .blog-main {
    flex: 1;
    padding: 3rem 1.5rem 4rem;
    min-width: 0;
  }

  @media (min-width: 768px) {
    .blog-main { padding: 3.5rem 2rem 5rem; }
  }

  @media (min-width: 1100px) {
    .blog-main { padding: 3.5rem 3rem 5rem; }
  }

  .posts-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 600px) {
    .posts-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1200px) {
    .posts-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .empty-state {
    text-align: center;
    font-family: var(--font-body);
    color: var(--color-text-muted);
    padding: 4rem 0;
  }

  /* ── CTA ── */
  .blog-cta {
    background: var(--color-lavender-mist);
    padding: 5rem 0;
    border-top: 1px solid var(--color-soft-lilac);
  }

  .cta-label {
    font-family: var(--font-accent);
    font-size: 1.375rem;
    color: var(--color-purple-heart);
    margin-bottom: 0.75rem;
  }

  .cta-title {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 2rem;
    color: var(--color-text-deep);
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .cta-desc {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  @media (min-width: 768px) {
    .cta-title { font-size: 2.5rem; }
  }
</style>
