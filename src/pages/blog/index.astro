---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BlogNav from '../../components/BlogNav.astro';
import Footer from '../../components/Footer.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const ERA_SHORT: Record<string, string> = {
  'ARIRANG (2026)':              'ARIRANG 2026',
  'BE (2020)':                   'BE 2020',
  'You Never Walk Alone (2017)': 'YNWA 2017',
  'Love Yourself: Tear (2018)':  'LY: Tear 2018',
};

// Pattern of 5: [dark wide+tall] [vibrant tall] [lavender] [light] [mid-lavender]
const COLORS = ['dark', 'vibrant', 'lavender', 'light', 'midlav'] as const;
const cardColors = posts.map((_, i) => COLORS[i % 5]);
---

<Layout
  title="El diario de una ARMY — Blog | Purple Heart Journal"
  description="Canciones de BTS analizadas como espejos de autoconocimiento. Reflexiones, prompts de journaling y una invitación a escribir lo que sientes."
>
  <BlogNav />

  <header class="blog-header">
    <div class="header-inner">
      <div class="header-left">
        <p class="header-eyebrow">El diario de una ARMY</p>
        <h1 class="header-title">Canciones que <em>nos enseñan</em> a conocernos</h1>
        <p class="header-desc">No somos un medio de noticias. Somos ARMY que escribe lo que siente.</p>
      </div>
      <div class="header-stat" aria-hidden="true">
        <span class="stat-num">{posts.length}</span>
        <span class="stat-label">canciones<br/>analizadas</span>
      </div>
    </div>
  </header>

  <div class="section-divider">
    <span class="divider-line"></span>
    <span class="divider-text">— {posts.length} entradas —</span>
    <span class="divider-line"></span>
  </div>

  <main class="bento-wrap">
    <div class="bento-grid">
      {posts.map((post, i) => {
        const color  = cardColors[i];
        const isDark = color === 'dark' || color === 'vibrant';
        const era    = ERA_SHORT[post.data.album] ?? post.data.album.replace(/ \(\d{4}\)$/, '');
        const isARI  = post.data.album.includes('ARIRANG');
        const lines  = post.data.quote ? post.data.quote.split(' / ') : [];

        return (
          <a
            href={`/blog/${post.id}`}
            class={`bento-card color-${color}`}
            data-song={post.data.song}
          >
            {/* Decorative blob — solo cards oscuras */}
            {isDark && <span class="deco-blob" aria-hidden="true" />}

            <span class={`era-pill ${isDark ? 'pill-dark' : isARI ? 'pill-ari' : 'pill-cl'}`}>
              {era}
            </span>

            {color === 'dark' ? (
              /* ── Wide + tall dark: lírica hero ── */
              <>
                <div class="quote-zone">
                  <span class="overflow-quote" aria-hidden="true">"</span>
                  <p class="lyric-hero">
                    {lines.length > 0
                      ? lines.map((l, li) => (<>{l}{li < lines.length - 1 && <br />}</>))
                      : post.data.excerpt.slice(0, 100)}
                  </p>
                </div>
                <div class="dark-footer">
                  <div>
                    <p class="dark-song">{post.data.song}</p>
                    <p class="dark-excerpt">{post.data.excerpt}</p>
                  </div>
                  <span class="cta-arrow" aria-hidden="true">→</span>
                </div>
              </>
            ) : color === 'vibrant' ? (
              /* ── Tall vibrant: canción + lírica completa ── */
              <>
                <h2 class="vibrant-song">{post.data.song}</h2>
                {lines.length > 0 && (
                  <p class="vibrant-lyric">
                    {lines.map((l, li) => (<>{l}{li < lines.length - 1 && <br />}</>))}
                  </p>
                )}
                <p class="vibrant-excerpt">{post.data.excerpt}</p>
                <span class="cta-text light-cta">Leer análisis →</span>
              </>
            ) : (
              /* ── Normal cards: light / lavender / midlav ── */
              <>
                <h2 class="card-song">{post.data.song}</h2>
                {lines[0] && <p class="card-lyric">"{lines[0]}"</p>}
                <p class="card-excerpt">{post.data.excerpt}</p>
                <span class="cta-text light-cta">Leer →</span>
              </>
            )}
          </a>
        );
      })}
    </div>
  </main>

  <section class="blog-cta">
    <div class="cta-inner">
      <p class="cta-eyebrow">¿Quieres escribir con BTS de fondo?</p>
      <h2 class="cta-title">El journal que habla<br/>en nuestro idioma</h2>
      <p class="cta-desc">85+ prompts guiados por 35 canciones de BTS.<br/>Para ARMY que escribe entre canciones.</p>
      <a href="https://pay.hotmart.com/P104306248S" class="cta-btn" target="_blank" rel="noopener noreferrer">
        Conoce el journal 💜
      </a>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* ══ Header ══ */
  .blog-header {
    background: linear-gradient(135deg, #1A0A2E 0%, #3D1278 55%, #9B4DCA 100%);
    padding: 2.25rem 1.5rem 2rem;
    position: relative;
    overflow: hidden;
  }

  .blog-header::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 80% 50%, rgba(199,125,255,0.1) 0%, transparent 60%);
    pointer-events: none;
  }

  .header-inner {
    max-width: 72rem;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    position: relative;
    z-index: 1;
  }

  .header-left { flex: 1; }

  .header-eyebrow {
    font-family: var(--font-accent);
    font-size: 1.125rem;
    color: var(--color-purple-heart);
    margin-bottom: 0.5rem;
  }

  .header-title {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    line-height: 1.15;
    color: #FDFBFF;
    margin-bottom: 0.625rem;
  }

  .header-desc {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: rgba(224, 208, 240, 0.6);
    max-width: 32rem;
  }

  .header-stat {
    display: none;
    flex-direction: column;
    align-items: flex-end;
    flex-shrink: 0;
  }

  @media (min-width: 600px) { .header-stat { display: flex; } }

  .stat-num {
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 700;
    font-size: clamp(4rem, 10vw, 7rem);
    line-height: 0.9;
    color: rgba(199, 125, 255, 0.13);
    letter-spacing: -0.04em;
    user-select: none;
  }

  .stat-label {
    font-family: var(--font-body);
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(199, 125, 255, 0.3);
    text-align: right;
    line-height: 1.6;
  }

  /* ══ Divider ══ */
  .section-divider {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 2rem;
    background: #F3EAFA;
    border-bottom: 1px solid #E0D0F0;
  }

  .divider-line { flex: 1; height: 1px; background: #E0D0F0; }

  .divider-text {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 0.8125rem;
    color: rgba(107, 91, 123, 0.45);
    letter-spacing: 0.06em;
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* ══ Bento wrap ══ */
  .bento-wrap {
    background: #F3EAFA;
    padding: 1.25rem 1.25rem 5rem;
  }

  @media (min-width: 768px) { .bento-wrap { padding: 1.75rem 2rem 6rem; } }

  /* ══ Grid ══ */
  .bento-grid {
    display: grid;
    grid-template-columns: 1fr;
    grid-auto-rows: minmax(200px, auto);
    gap: 0.75rem;
    max-width: 72rem;
    margin: 0 auto;
  }

  @media (min-width: 560px) {
    .bento-grid { grid-template-columns: repeat(2, 1fr); }
    /* dark (5n+1): 2 cols wide + 2 rows tall */
    .bento-card:nth-child(5n+1) { grid-column: span 2; grid-row: span 2; }
    /* vibrant (5n+2): 2 rows tall */
    .bento-card:nth-child(5n+2) { grid-row: span 2; }
  }

  @media (min-width: 900px) {
    .bento-grid { grid-template-columns: repeat(3, 1fr); }
    .bento-card:nth-child(5n+1) { grid-column: span 2; grid-row: span 2; }
    .bento-card:nth-child(5n+2) { grid-row: span 2; }
  }

  /* ══ Base card ══ */
  .bento-card {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: 1.5rem;
    padding: 1.625rem 1.5rem 1.375rem;
    text-decoration: none;
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .bento-card:hover { transform: translateY(-4px); }

  /* Watermark: nombre de la canción como elemento gráfico de fondo */
  .bento-card::after {
    content: attr(data-song);
    position: absolute;
    bottom: 0.75rem;
    right: 1rem;
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 600;
    font-size: 3rem;
    line-height: 1;
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
    z-index: 0;
    /* color se sobreescribe por color de card */
  }

  /* ══ Dark card ══ */
  .color-dark {
    background: linear-gradient(140deg, #1A0A2E 0%, #3B1066 55%, #6B2FA0 100%);
    box-shadow: 0 6px 28px rgba(26, 10, 46, 0.32);
  }

  .color-dark::after {
    color: rgba(255, 255, 255, 0.035);
    font-size: 4rem;
  }

  .color-dark:hover { box-shadow: 0 12px 48px rgba(107, 47, 160, 0.5); }

  /* ══ Vibrant card ══ */
  .color-vibrant {
    background: linear-gradient(145deg, #7B2FBE 0%, #9B4DCA 50%, #C77DFF 100%);
    box-shadow: 0 4px 20px rgba(155, 77, 202, 0.3);
  }

  .color-vibrant::after { color: rgba(255, 255, 255, 0.07); }
  .color-vibrant:hover { box-shadow: 0 10px 40px rgba(199, 125, 255, 0.45); }

  /* ══ Lavender card ══ */
  .color-lavender {
    background: #EAD8F8;
    border: 1px solid rgba(199, 125, 255, 0.2);
    border-top: 3px solid #C77DFF;
    box-shadow: 0 2px 10px rgba(199, 125, 255, 0.08);
  }

  .color-lavender::after { color: rgba(155, 77, 202, 0.065); }
  .color-lavender:hover { box-shadow: 0 8px 30px rgba(199, 125, 255, 0.22); border-color: rgba(199, 125, 255, 0.4); border-top-color: #C77DFF; }

  /* ══ Light card ══ */
  .color-light {
    background: #FDFBFF;
    border: 1px solid #E0D0F0;
    border-top: 3px solid #9B4DCA;
    box-shadow: 0 2px 10px rgba(107, 91, 123, 0.07);
  }

  .color-light::after { color: rgba(155, 77, 202, 0.05); }
  .color-light:hover { box-shadow: 0 8px 30px rgba(155, 77, 202, 0.15); border-color: rgba(155, 77, 202, 0.3); border-top-color: #9B4DCA; }

  /* ══ Mid-lavender card ══ */
  .color-midlav {
    background: linear-gradient(135deg, #F3EAFA 0%, #E0D0F0 100%);
    border: 1px solid rgba(155, 77, 202, 0.15);
    border-top: 3px solid #9B4DCA;
    box-shadow: 0 2px 10px rgba(107, 91, 123, 0.06);
  }

  .color-midlav::after { color: rgba(155, 77, 202, 0.065); }
  .color-midlav:hover { box-shadow: 0 8px 30px rgba(155, 77, 202, 0.18); border-color: rgba(155, 77, 202, 0.3); }

  /* ══ Decorative blob (dark + vibrant cards) ══ */
  .deco-blob {
    position: absolute;
    bottom: -20%;
    right: -8%;
    width: 220px;
    height: 220px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(199,125,255,0.18) 0%, transparent 70%);
    pointer-events: none;
  }

  /* ══ Era pill ══ */
  .era-pill {
    display: inline-block;
    font-family: var(--font-accent);
    font-size: 0.75rem;
    padding: 0.15rem 0.7rem;
    border-radius: 999px;
    align-self: flex-start;
    margin-bottom: 1rem;
    flex-shrink: 0;
    position: relative;
    z-index: 1;
  }

  .pill-dark {
    background: rgba(199, 125, 255, 0.15);
    color: rgba(199, 125, 255, 0.9);
    border: 1px solid rgba(199, 125, 255, 0.3);
  }

  .pill-ari {
    background: rgba(199, 125, 255, 0.12);
    color: #7B2FBE;
    border: 1px solid rgba(199, 125, 255, 0.25);
  }

  .pill-cl {
    background: rgba(155, 77, 202, 0.08);
    color: #5B2C8E;
    border: 1px solid rgba(155, 77, 202, 0.18);
  }

  /* ══ Dark card content ══ */
  .quote-zone {
    flex: 1;
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
  }

  /* Gran comilla que sangra del borde superior */
  .overflow-quote {
    font-family: var(--font-heading);
    font-size: 8rem;
    line-height: 0.6;
    color: rgba(199, 125, 255, 0.18);
    display: block;
    margin-left: -0.25rem;
    margin-bottom: 0.25rem;
    user-select: none;
    flex-shrink: 0;
  }

  .lyric-hero {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: clamp(1.375rem, 2.5vw, 1.875rem);
    line-height: 1.45;
    color: #FDFBFF;
    flex: 1;
  }

  .dark-footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.5rem;
    padding-top: 0.875rem;
    border-top: 1px solid rgba(199, 125, 255, 0.15);
    position: relative;
    z-index: 1;
  }

  .dark-song {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 1rem;
    font-weight: 600;
    color: #C77DFF;
    margin-bottom: 0.25rem;
  }

  .dark-excerpt {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    line-height: 1.55;
    color: rgba(224, 208, 240, 0.45);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    max-width: 36rem;
  }

  .cta-arrow {
    font-size: 1.25rem;
    color: rgba(199, 125, 255, 0.4);
    transition: color 0.2s, transform 0.2s;
    flex-shrink: 0;
  }

  .color-dark:hover .cta-arrow {
    color: #C77DFF;
    transform: translateX(5px);
  }

  /* ══ Vibrant card content ══ */
  .vibrant-song {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: clamp(1.625rem, 3vw, 2.25rem);
    line-height: 1.1;
    color: #FDFBFF;
    margin-bottom: 0.75rem;
    position: relative;
    z-index: 1;
  }

  .vibrant-lyric {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: rgba(253, 251, 255, 0.65);
    margin-bottom: 0.875rem;
    flex: 1;
    position: relative;
    z-index: 1;
  }

  .vibrant-excerpt {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    line-height: 1.6;
    color: rgba(253, 251, 255, 0.55);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    position: relative;
    z-index: 1;
  }

  /* ══ Normal card content ══ */
  .card-song {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: clamp(1.5rem, 2.8vw, 2rem);
    line-height: 1.1;
    color: var(--color-text-deep);
    margin-bottom: 0.5rem;
    transition: color 0.2s ease;
    position: relative;
    z-index: 1;
  }

  .color-light:hover .card-song,
  .color-lavender:hover .card-song,
  .color-midlav:hover .card-song { color: var(--color-purple-vibrant); }

  .card-lyric {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 0.875rem;
    line-height: 1.55;
    color: rgba(107, 91, 123, 0.5);
    margin-bottom: 0.75rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.2s;
    position: relative;
    z-index: 1;
  }

  .color-light:hover .card-lyric,
  .color-lavender:hover .card-lyric,
  .color-midlav:hover .card-lyric { color: rgba(155, 77, 202, 0.65); }

  .card-excerpt {
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
    position: relative;
    z-index: 1;
  }

  /* ══ CTAs ══ */
  .cta-text {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    margin-top: 1rem;
    align-self: flex-end;
    position: relative;
    z-index: 1;
    transition: color 0.2s, transform 0.2s;
  }

  .light-cta { color: rgba(107, 91, 123, 0.4); }

  .color-light:hover .light-cta,
  .color-lavender:hover .light-cta,
  .color-midlav:hover .light-cta { color: var(--color-purple-vibrant); transform: translateX(4px); }

  .color-vibrant .light-cta { color: rgba(253, 251, 255, 0.5); }
  .color-vibrant:hover .light-cta { color: #FDFBFF; transform: translateX(4px); }

  /* ══ CTA section ══ */
  .blog-cta {
    background: linear-gradient(135deg, #1A0A2E 0%, #3B1066 100%);
    padding: 4.5rem 1.5rem;
    position: relative;
    overflow: hidden;
  }

  .blog-cta::before {
    content: '';
    position: absolute;
    top: -30%;
    left: -10%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(199, 125, 255, 0.07) 0%, transparent 70%);
    pointer-events: none;
  }

  .cta-inner {
    max-width: 36rem;
    margin: 0 auto;
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .cta-eyebrow {
    font-family: var(--font-accent);
    font-size: 1.25rem;
    color: var(--color-purple-heart);
    margin-bottom: 0.75rem;
  }

  .cta-title {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    color: #FDFBFF;
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .cta-desc {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.7;
    color: rgba(224, 208, 240, 0.65);
    margin-bottom: 2rem;
  }

  .cta-btn {
    display: inline-block;
    background: linear-gradient(135deg, #9B4DCA, #C77DFF);
    color: #FDFBFF;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1rem;
    padding: 0.9rem 2rem;
    border-radius: 0.75rem;
    text-decoration: none;
    transition: box-shadow 0.3s, transform 0.3s;
    box-shadow: 0 0 24px rgba(199, 125, 255, 0.28);
    cursor: pointer;
  }

  .cta-btn:hover {
    box-shadow: 0 0 40px rgba(199, 125, 255, 0.5);
    transform: translateY(-2px);
  }
</style>
