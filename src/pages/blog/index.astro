---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BlogNav from '../../components/BlogNav.astro';
import Footer from '../../components/Footer.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const albumOrder = [
  'ARIRANG (2026)',
  'BE (2020)',
  'You Never Walk Alone (2017)',
  'Love Yourself: Tear (2018)',
];
---

<Layout
  title="El diario de una ARMY — Blog | Purple Heart Journal"
  description="Canciones de BTS analizadas como espejos de autoconocimiento. Reflexiones, prompts de journaling y una invitación a escribir lo que sientes."
>
  <BlogNav />

  <!-- Header -->
  <header class="blog-header">
    <div class="header-inner">
      <div class="header-left">
        <p class="header-eyebrow">El diario de una ARMY</p>
        <h1 class="header-title">Canciones que<br /><em>nos enseñan</em><br />a conocernos</h1>
        <p class="header-desc">
          No somos un medio de noticias de BTS. Somos ARMY que escribe lo que siente
          y que encuentra en las canciones el espejo perfecto para hacerlo.
        </p>
      </div>
      <div class="header-right" aria-hidden="true">
        <span class="header-count-num">{posts.length}</span>
        <span class="header-count-label">canciones<br/>analizadas</span>
      </div>
    </div>
  </header>

  <!-- Separador editorial -->
  <div class="section-divider">
    <span class="divider-line"></span>
    <span class="divider-text">— {posts.length} entradas —</span>
    <span class="divider-line"></span>
  </div>

  <!-- Tracklist: layout tipo setlist / contracubierta de álbum -->
  <main class="tracklist-wrap">

    <!-- Era headers con entradas como tracklist -->
    {albumOrder.map(album => {
      const albumPosts = posts.filter(p => p.data.album === album);
      if (!albumPosts.length) return null;
      const albumName = album.replace(/ \(\d{4}\)$/, '');
      const albumYear = album.match(/\((\d+)\)/)?.[1] ?? '';
      return (
        <section class="era-section">
          <div class="era-header">
            <span class="era-year">{albumYear}</span>
            <h2 class="era-name">{albumName}</h2>
            <span class="era-count">{albumPosts.length} entrada{albumPosts.length !== 1 ? 's' : ''}</span>
          </div>
          <div class="tracklist">
            {albumPosts.map((post, i) => (
              <a href={`/blog/${post.id}`} class="track-item">
                <span class="track-num">{String(i + 1).padStart(2, '0')}</span>
                <div class="track-body">
                  <div class="track-top">
                    <span class="track-song">{post.data.song}</span>
                    {post.data.quote && (
                      <span class="track-quote">
                        "{post.data.quote.split(' / ')[0]}"
                      </span>
                    )}
                  </div>
                  <p class="track-excerpt">{post.data.excerpt}</p>
                </div>
                <span class="track-arrow" aria-hidden="true">→</span>
              </a>
            ))}
          </div>
        </section>
      );
    })}

  </main>

  <!-- CTA -->
  <section class="blog-cta">
    <div class="cta-inner">
      <p class="cta-label">¿Quieres escribir con BTS de fondo?</p>
      <h2 class="cta-title">El journal que habla en nuestro idioma</h2>
      <p class="cta-desc">
        85+ prompts de journaling guiados por 35 canciones de BTS.<br />
        Para ARMY que escribe entre canciones.
      </p>
      <a
        href="https://pay.hotmart.com/P104306248S"
        class="cta-btn"
        target="_blank"
        rel="noopener noreferrer"
      >
        Conoce el journal 💜
      </a>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* ── Header ── */
  .blog-header {
    background: linear-gradient(135deg, #1A0A2E 0%, #3D1278 55%, #9B4DCA 100%);
    padding: 4.5rem 1.5rem 4rem;
    position: relative;
    overflow: hidden;
  }

  .blog-header::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 80% 50%, rgba(199,125,255,0.1) 0%, transparent 60%);
    pointer-events: none;
  }

  .header-inner {
    max-width: 72rem;
    margin: 0 auto;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    position: relative;
    z-index: 1;
  }

  .header-left { flex: 1; }

  .header-eyebrow {
    font-family: var(--font-accent);
    font-size: 0.8125rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-purple-heart);
    margin-bottom: 1.25rem;
  }

  .header-title {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: clamp(2.25rem, 5vw, 4rem);
    line-height: 1.08;
    color: #FDFBFF;
    margin-bottom: 1.5rem;
  }

  .header-desc {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.75;
    color: rgba(224, 208, 240, 0.65);
    max-width: 36rem;
  }

  .header-right {
    display: none;
    flex-direction: column;
    align-items: flex-end;
    flex-shrink: 0;
    padding-bottom: 0.5rem;
  }

  @media (min-width: 600px) { .header-right { display: flex; } }

  .header-count-num {
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 700;
    font-size: clamp(6rem, 14vw, 10rem);
    line-height: 0.9;
    color: rgba(199, 125, 255, 0.13);
    letter-spacing: -0.04em;
    user-select: none;
  }

  .header-count-label {
    font-family: var(--font-body);
    font-size: 0.5625rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(199, 125, 255, 0.35);
    text-align: right;
    line-height: 1.6;
    margin-top: 0.25rem;
  }

  /* ── Separador ── */
  .section-divider {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem 2rem;
    background: #FDFBFF;
    border-bottom: 1px solid var(--color-soft-lilac);
  }

  .divider-line {
    flex: 1;
    height: 1px;
    background: var(--color-soft-lilac);
  }

  .divider-text {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 0.8125rem;
    color: rgba(107, 91, 123, 0.45);
    letter-spacing: 0.06em;
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* ── Tracklist wrap ── */
  .tracklist-wrap {
    background: #FDFBFF;
    padding: 3rem 1.5rem 5rem;
  }

  @media (min-width: 768px) {
    .tracklist-wrap { padding: 3.5rem 2.5rem 6rem; }
  }

  /* ── Era section ── */
  .era-section {
    max-width: 60rem;
    margin: 0 auto 4rem;
  }

  .era-section:last-child { margin-bottom: 0; }

  .era-header {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-bottom: 1rem;
    margin-bottom: 0;
    border-bottom: 2px solid var(--color-text-deep);
  }

  .era-year {
    font-family: var(--font-body);
    font-size: 0.625rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-purple-heart);
    flex-shrink: 0;
  }

  .era-name {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 600;
    line-height: 1;
    color: var(--color-text-deep);
    flex: 1;
  }

  .era-count {
    font-family: var(--font-body);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(107, 91, 123, 0.35);
    flex-shrink: 0;
  }

  /* ── Tracklist ── */
  .tracklist {
    display: flex;
    flex-direction: column;
  }

  /* ── Track item ── */
  .track-item {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    padding: 1.375rem 0.5rem 1.375rem 0;
    border-bottom: 1px solid rgba(224, 208, 240, 0.55);
    text-decoration: none;
    cursor: pointer;
    position: relative;
    transition: background 0.2s ease, padding-left 0.22s ease;
    border-radius: 0 0.5rem 0.5rem 0;
  }

  .track-item::before {
    content: '';
    position: absolute;
    left: -1.5rem;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--color-purple-heart);
    opacity: 0;
    transition: opacity 0.2s ease;
    border-radius: 0 2px 2px 0;
  }

  @media (min-width: 768px) {
    .track-item:hover {
      padding-left: 1rem;
      background: rgba(199, 125, 255, 0.04);
    }
    .track-item:hover::before { opacity: 1; }
  }

  /* Número de track */
  .track-num {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 700;
    color: rgba(107, 91, 123, 0.3);
    letter-spacing: 0.06em;
    min-width: 1.75rem;
    flex-shrink: 0;
    padding-top: 0.5rem;
    transition: color 0.2s ease;
    user-select: none;
  }

  .track-item:hover .track-num { color: var(--color-purple-heart); }

  /* Cuerpo del track */
  .track-body {
    flex: 1;
    min-width: 0;
  }

  .track-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 0.25rem;
  }

  /* Nombre de la canción — protagonista */
  .track-song {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: clamp(1.625rem, 3.5vw, 2.375rem);
    line-height: 1.1;
    color: var(--color-text-deep);
    transition: color 0.2s ease;
    flex-shrink: 0;
  }

  .track-item:hover .track-song { color: var(--color-purple-vibrant); }

  /* Primera línea de la lírica — derecha */
  .track-quote {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 0.8125rem;
    color: rgba(107, 91, 123, 0.4);
    text-align: right;
    line-height: 1.4;
    flex-shrink: 1;
    transition: color 0.2s ease;
    max-width: 18rem;
  }

  .track-item:hover .track-quote { color: rgba(155, 77, 202, 0.55); }

  /* Excerpt: oculto, aparece en hover */
  .track-excerpt {
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition: max-height 0.32s ease, opacity 0.25s ease;
  }

  .track-item:hover .track-excerpt {
    max-height: 6rem;
    opacity: 1;
  }

  /* Flecha de navegación */
  .track-arrow {
    font-family: var(--font-body);
    font-size: 1rem;
    color: rgba(107, 91, 123, 0.2);
    flex-shrink: 0;
    transition: color 0.2s, transform 0.22s;
    align-self: center;
    padding-left: 0.5rem;
  }

  .track-item:hover .track-arrow {
    color: var(--color-purple-heart);
    transform: translateX(5px);
  }

  /* ── CTA ── */
  .blog-cta {
    background: linear-gradient(135deg, #1A0A2E 0%, #3B1066 100%);
    padding: 5rem 1.5rem;
    position: relative;
    overflow: hidden;
  }

  .blog-cta::before {
    content: '';
    position: absolute;
    top: -30%;
    left: -10%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(199, 125, 255, 0.07) 0%, transparent 70%);
    pointer-events: none;
  }

  .cta-inner {
    max-width: 36rem;
    margin: 0 auto;
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .cta-label {
    font-family: var(--font-accent);
    font-size: 1.125rem;
    color: var(--color-purple-heart);
    margin-bottom: 0.75rem;
  }

  .cta-title {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    color: #FDFBFF;
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .cta-desc {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.7;
    color: rgba(224, 208, 240, 0.65);
    margin-bottom: 2rem;
  }

  .cta-btn {
    display: inline-block;
    background: linear-gradient(135deg, #9B4DCA, #C77DFF);
    color: #FDFBFF;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1rem;
    padding: 0.9rem 2rem;
    border-radius: 0.75rem;
    text-decoration: none;
    transition: box-shadow 0.3s ease, transform 0.3s ease;
    box-shadow: 0 0 24px rgba(199, 125, 255, 0.28);
    cursor: pointer;
  }

  .cta-btn:hover {
    box-shadow: 0 0 40px rgba(199, 125, 255, 0.5);
    transform: translateY(-2px);
  }
</style>
