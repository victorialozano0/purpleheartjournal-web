---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BlogNav from '../../components/BlogNav.astro';
import Footer from '../../components/Footer.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const ERA_SHORT: Record<string, string> = {
  'ARIRANG (2026)':              'ARIRANG 2026',
  'BE (2020)':                   'BE 2020',
  'You Never Walk Alone (2017)': 'YNWA 2017',
  'Love Yourself: Tear (2018)':  'LY: Tear 2018',
};

const era  = (p: typeof posts[0]) => ERA_SHORT[p.data.album] ?? p.data.album.replace(/ \(\d{4}\)$/, '');
const lns  = (p: typeof posts[0]) => p.data.quote?.split(' / ') ?? [];
const isAR = (p: typeof posts[0]) => p.data.album.includes('ARIRANG');

// Marquee: concatenar varias líricas
const marqueeText = posts
  .filter(p => p.data.quote)
  .slice(0, 6)
  .map(p => p.data.quote!.split(' / ')[0])
  .join('  ·  ');
---

<Layout
  title="El diario de una ARMY — Blog | Purple Heart Journal"
  description="Canciones de BTS analizadas como espejos de autoconocimiento. Reflexiones, prompts de journaling y una invitación a escribir lo que sientes."
>
  <BlogNav />

  <!-- ─── Header mínimo ─── -->
  <header class="blog-header">
    <div class="header-inner">
      <div>
        <p class="header-eyebrow">El diario de una ARMY</p>
        <h1 class="header-title">Canciones que <em>nos enseñan</em> a conocernos</h1>
      </div>
      <div class="header-stat" aria-hidden="true">
        <span class="stat-num">{posts.length}</span>
        <span class="stat-label">canciones analizadas</span>
      </div>
    </div>
  </header>

  <!-- ═══════════════════════════════════════════
       HÉROE — post más reciente, full width
  ═══════════════════════════════════════════ -->
  {posts[0] && (
    <a href={`/blog/${posts[0].id}`} class="hero-post">
      <!-- Blob decorativo -->
      <span class="hero-blob" aria-hidden="true" />
      <span class="hero-blob hero-blob-2" aria-hidden="true" />

      <div class="hero-top">
        <span class="hero-era-pill">{era(posts[0])}</span>
        <span class="hero-count">01 / {String(posts.length).padStart(2,'0')}</span>
      </div>

      <!-- Comilla enorme como elemento gráfico -->
      <span class="hero-giant-quote" aria-hidden="true">"</span>

      <div class="hero-lyric-block">
        {lns(posts[0]).map((l, i) => (
          <p class={`hero-lyric-line ${i > 0 ? 'hero-lyric-indent' : ''}`}>{l}</p>
        ))}
      </div>

      <div class="hero-bottom">
        <div>
          <p class="hero-song">{posts[0].data.song}</p>
          <p class="hero-excerpt">{posts[0].data.excerpt}</p>
        </div>
        <span class="hero-cta">Leer análisis <span class="arrow-long">→</span></span>
      </div>
    </a>
  )}

  <!-- ═══════════════════════════════════════════
       MARQUEE — líricas en movimiento
  ═══════════════════════════════════════════ -->
  <div class="marquee-strip" aria-hidden="true">
    <div class="marquee-track">
      <span class="marquee-text">{marqueeText} &nbsp;&nbsp;&nbsp;&nbsp; {marqueeText} &nbsp;&nbsp;&nbsp;&nbsp;</span>
      <span class="marquee-text" aria-hidden="true">{marqueeText} &nbsp;&nbsp;&nbsp;&nbsp; {marqueeText} &nbsp;&nbsp;&nbsp;&nbsp;</span>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════
       PARES ASIMÉTRICOS — posts 1–4
  ═══════════════════════════════════════════ -->
  <div class="asym-wrap">

    <!-- Par 1: ancho izquierda + estrecho derecha -->
    {posts[1] && posts[2] && (
      <div class="asym-row">
        <a href={`/blog/${posts[1].id}`} class="asym-card asym-main card-lavender">
          <span class="asym-era">{era(posts[1])}</span>
          <h2 class="asym-song">{posts[1].data.song}</h2>
          {lns(posts[1])[0] && <p class="asym-lyric">"{lns(posts[1])[0]}"</p>}
          <p class="asym-excerpt">{posts[1].data.excerpt}</p>
          <span class="asym-cta">Leer →</span>
        </a>
        <a href={`/blog/${posts[2].id}`} class="asym-card asym-side card-dark">
          <span class="asym-side-blob" aria-hidden="true" />
          <span class="asym-era era-light">{era(posts[2])}</span>
          <div class="asym-side-lyric">
            {lns(posts[2]).map((l, i) => (
              <p class={`side-lyric-line ${i > 0 ? 'side-lyric-indent' : ''}`}>{l}</p>
            ))}
          </div>
          <p class="asym-side-song">{posts[2].data.song}</p>
          <span class="asym-cta era-light">Leer →</span>
        </a>
      </div>
    )}

    <!-- Par 2: estrecho izquierda + ancho derecha -->
    {posts[3] && posts[4] && (
      <div class="asym-row asym-row-flip">
        <a href={`/blog/${posts[3].id}`} class="asym-card asym-side card-vibrant">
          <span class="asym-side-blob" aria-hidden="true" />
          <span class="asym-era era-light">{era(posts[3])}</span>
          <div class="asym-side-lyric">
            {lns(posts[3]).map((l, i) => (
              <p class={`side-lyric-line ${i > 0 ? 'side-lyric-indent' : ''}`}>{l}</p>
            ))}
          </div>
          <p class="asym-side-song">{posts[3].data.song}</p>
          <span class="asym-cta era-light">Leer →</span>
        </a>
        <a href={`/blog/${posts[4].id}`} class="asym-card asym-main card-light">
          <span class="asym-era">{era(posts[4])}</span>
          <h2 class="asym-song">{posts[4].data.song}</h2>
          {lns(posts[4])[0] && <p class="asym-lyric">"{lns(posts[4])[0]}"</p>}
          <p class="asym-excerpt">{posts[4].data.excerpt}</p>
          <span class="asym-cta">Leer →</span>
        </a>
      </div>
    )}

  </div>

  <!-- ═══════════════════════════════════════════
       PULL QUOTE — post 5, full width editorial
  ═══════════════════════════════════════════ -->
  {posts[5] && (
    <a href={`/blog/${posts[5].id}`} class="pull-quote-section">
      <span class="pq-deco" aria-hidden="true">"</span>
      <div class="pq-body">
        <p class="pq-text">
          {lns(posts[5]).map((l, i) => (<>{l}{i < lns(posts[5]).length - 1 && <br />}</>))}
        </p>
        <p class="pq-song">— {posts[5].data.song}</p>
      </div>
      <span class="pq-cta">Leer análisis completo →</span>
    </a>
  )}

  <!-- ═══════════════════════════════════════════
       CLUSTER ROTADO — posts 6–8, cards "tiradas"
  ═══════════════════════════════════════════ -->
  <div class="cluster-wrap">
    <div class="cluster-label" aria-hidden="true">más entradas</div>
    <div class="cluster-row">
      {[posts[6], posts[7], posts[8]].map((post, ci) => post && (
        <a href={`/blog/${post.id}`} class={`cluster-card cluster-${ci} card-${['lavender','light','dark-sm'][ci]}`}>
          {ci === 2 && <span class="cluster-blob" aria-hidden="true" />}
          <span class={`cluster-era ${ci === 2 ? 'era-light' : ''}`}>{era(post)}</span>
          <h2 class={`cluster-song ${ci === 2 ? 'cluster-song-light' : ''}`}>{post.data.song}</h2>
          {lns(post)[0] && (
            <p class={`cluster-lyric ${ci === 2 ? 'cluster-lyric-light' : ''}`}>
              "{lns(post)[0]}"
            </p>
          )}
          <p class={`cluster-excerpt ${ci === 2 ? 'cluster-excerpt-light' : ''}`}>
            {post.data.excerpt}
          </p>
          <span class={`cluster-cta ${ci === 2 ? 'era-light' : ''}`}>Leer →</span>
        </a>
      ))}
    </div>
  </div>

  <!-- ═══════════════════════════════════════════
       MITAD Y MITAD — posts 9–10
  ═══════════════════════════════════════════ -->
  {posts[9] && posts[10] && (
    <div class="half-row">
      <a href={`/blog/${posts[9].id}`} class="half-card card-midlav">
        <span class="half-era">{era(posts[9])}</span>
        <h2 class="half-song">{posts[9].data.song}</h2>
        {lns(posts[9])[0] && <p class="half-lyric">"{lns(posts[9])[0]}"</p>}
        <p class="half-excerpt">{posts[9].data.excerpt}</p>
        <span class="half-cta">Leer →</span>
      </a>
      <a href={`/blog/${posts[10].id}`} class="half-card card-dark-half">
        <span class="half-blob" aria-hidden="true" />
        <span class="half-era era-light">{era(posts[10])}</span>
        <div class="half-lyric-block">
          {lns(posts[10]).map((l,i) => (
            <p class="half-lyric-line">{l}</p>
          ))}
        </div>
        <p class="half-song-dark">{posts[10].data.song}</p>
        <span class="half-cta era-light">Leer →</span>
      </a>
    </div>
  )}

  <!-- ═══════════════════════════════════════════
       FILA FINAL — posts 11–16
  ═══════════════════════════════════════════ -->
  <div class="final-wrap">
    <div class="final-grid">
      {posts.slice(11).map((post, fi) => {
        const colors = ['card-light','card-lavender','card-vibrant-sm','card-midlav','card-light','card-lavender'];
        return (
          <a href={`/blog/${post.id}`} class={`final-card ${colors[fi % colors.length]}`} data-song={post.data.song}>
            <span class="final-era">{era(post)}</span>
            <h2 class="final-song">{post.data.song}</h2>
            {lns(post)[0] && <p class="final-lyric">"{lns(post)[0]}"</p>}
            <p class="final-excerpt">{post.data.excerpt}</p>
            <span class="final-cta">Leer →</span>
          </a>
        );
      })}
    </div>
  </div>

  <!-- ═══════════════════════════════════════════
       CTA
  ═══════════════════════════════════════════ -->
  <section class="blog-cta">
    <div class="cta-inner">
      <p class="cta-eyebrow">¿Quieres escribir con BTS de fondo?</p>
      <h2 class="cta-title">El journal que habla<br/>en nuestro idioma</h2>
      <p class="cta-desc">85+ prompts guiados por 35 canciones de BTS.<br/>Para ARMY que escribe entre canciones.</p>
      <a href="https://pay.hotmart.com/P104306248S" class="cta-btn" target="_blank" rel="noopener noreferrer">
        Conoce el journal 💜
      </a>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* ══ Header ══ */
  .blog-header {
    background: linear-gradient(135deg, #1A0A2E 0%, #3D1278 55%, #9B4DCA 100%);
    padding: 1.75rem 1.5rem 1.625rem;
  }

  .header-inner {
    max-width: 72rem;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .header-eyebrow {
    font-family: var(--font-accent);
    font-size: 1rem;
    color: var(--color-purple-heart);
    margin-bottom: 0.35rem;
  }

  .header-title {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    line-height: 1.15;
    color: #FDFBFF;
  }

  .header-stat { display: none; flex-direction: column; align-items: flex-end; }
  @media (min-width: 600px) { .header-stat { display: flex; } }

  .stat-num {
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 700;
    font-size: clamp(3.5rem, 9vw, 6rem);
    line-height: 0.9;
    color: rgba(199, 125, 255, 0.15);
    letter-spacing: -0.04em;
    user-select: none;
  }

  .stat-label {
    font-family: var(--font-body);
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(199, 125, 255, 0.3);
    text-align: right;
  }

  /* ══════════════════════════════════════
     HÉROE
  ══════════════════════════════════════ */
  .hero-post {
    display: block;
    position: relative;
    background: linear-gradient(150deg, #0D051E 0%, #2A0A5E 45%, #5B2C8E 100%);
    padding: 3rem 1.75rem 2.5rem;
    text-decoration: none;
    overflow: hidden;
    cursor: pointer;
    min-height: 52vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: filter 0.3s;
  }

  @media (min-width: 768px) {
    .hero-post { padding: 3.5rem 5vw 3rem; min-height: 58vh; }
  }

  .hero-post:hover { filter: brightness(1.07); }

  /* Blobs decorativos */
  .hero-blob {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }

  .hero-blob:first-of-type {
    width: 55vw;
    height: 55vw;
    max-width: 600px;
    max-height: 600px;
    top: -20%;
    right: -10%;
    background: radial-gradient(circle, rgba(199,125,255,0.15) 0%, transparent 65%);
  }

  .hero-blob-2 {
    width: 30vw;
    height: 30vw;
    max-width: 320px;
    max-height: 320px;
    bottom: -10%;
    left: 15%;
    background: radial-gradient(circle, rgba(91,44,142,0.4) 0%, transparent 70%);
  }

  .hero-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
    z-index: 1;
    margin-bottom: 1.5rem;
  }

  .hero-era-pill {
    font-family: var(--font-accent);
    font-size: 0.875rem;
    color: rgba(199, 125, 255, 0.8);
    background: rgba(199, 125, 255, 0.12);
    border: 1px solid rgba(199, 125, 255, 0.25);
    padding: 0.2rem 0.75rem;
    border-radius: 999px;
  }

  .hero-count {
    font-family: var(--font-body);
    font-size: 0.625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(199, 125, 255, 0.3);
  }

  /* Comilla enorme — elemento gráfico */
  .hero-giant-quote {
    font-family: var(--font-heading);
    font-size: clamp(10rem, 22vw, 18rem);
    line-height: 0.7;
    color: rgba(199, 125, 255, 0.08);
    position: absolute;
    top: 0.5rem;
    left: 1rem;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }

  .hero-lyric-block {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    z-index: 1;
    padding: 1rem 0;
  }

  .hero-lyric-line {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: clamp(2rem, 5.5vw, 4.5rem);
    line-height: 1.15;
    color: #FDFBFF;
    letter-spacing: -0.02em;
  }

  .hero-lyric-indent { padding-left: clamp(1rem, 5vw, 5rem); }

  .hero-bottom {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    position: relative;
    z-index: 1;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(199, 125, 255, 0.12);
  }

  .hero-song {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 1rem;
    font-weight: 600;
    color: #C77DFF;
    margin-bottom: 0.3rem;
  }

  .hero-excerpt {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    line-height: 1.55;
    color: rgba(224, 208, 240, 0.4);
    max-width: 38rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .hero-cta {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    color: rgba(199, 125, 255, 0.6);
    white-space: nowrap;
    flex-shrink: 0;
    transition: color 0.2s;
  }

  .hero-post:hover .hero-cta { color: #C77DFF; }

  .arrow-long {
    display: inline-block;
    transition: transform 0.25s;
  }

  .hero-post:hover .arrow-long { transform: translateX(6px); }

  /* ══════════════════════════════════════
     MARQUEE
  ══════════════════════════════════════ */
  .marquee-strip {
    background: #9B4DCA;
    padding: 0.75rem 0;
    overflow: hidden;
    white-space: nowrap;
  }

  .marquee-track {
    display: inline-flex;
    animation: scroll-left 28s linear infinite;
  }

  .marquee-text {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 0.9375rem;
    color: rgba(253, 251, 255, 0.7);
    padding-right: 2rem;
    letter-spacing: 0.02em;
  }

  @keyframes scroll-left {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  /* ══════════════════════════════════════
     PARES ASIMÉTRICOS
  ══════════════════════════════════════ */
  .asym-wrap {
    background: #F3EAFA;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  @media (min-width: 768px) { .asym-wrap { padding: 1.5rem 2rem; } }

  .asym-row {
    display: flex;
    gap: 0.75rem;
    align-items: stretch;
    flex-direction: column;
  }

  @media (min-width: 600px) { .asym-row { flex-direction: row; } }

  .asym-card {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: 1.25rem;
    padding: 1.5rem;
    text-decoration: none;
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.25s, box-shadow 0.25s;
    min-height: 260px;
  }

  .asym-card:hover { transform: translateY(-3px); }

  .asym-main  { flex: 2; }
  .asym-side  { flex: 1; }

  /* Card colors */
  .card-lavender {
    background: #EAD8F8;
    border: 1px solid rgba(199,125,255,0.2);
    border-top: 3px solid #C77DFF;
    box-shadow: 0 2px 10px rgba(199,125,255,0.08);
  }
  .card-lavender:hover { box-shadow: 0 8px 28px rgba(199,125,255,0.2); }

  .card-dark {
    background: linear-gradient(145deg, #1A0A2E 0%, #3B1066 55%, #6B2FA0 100%);
    box-shadow: 0 4px 18px rgba(26,10,46,0.3);
  }
  .card-dark:hover { box-shadow: 0 10px 36px rgba(91,44,142,0.45); }

  .card-vibrant {
    background: linear-gradient(145deg, #7B2FBE 0%, #9B4DCA 50%, #C77DFF 100%);
    box-shadow: 0 4px 18px rgba(155,77,202,0.3);
  }
  .card-vibrant:hover { box-shadow: 0 10px 36px rgba(199,125,255,0.42); }

  .card-light {
    background: #FDFBFF;
    border: 1px solid #E0D0F0;
    border-top: 3px solid #9B4DCA;
    box-shadow: 0 2px 10px rgba(107,91,123,0.07);
  }
  .card-light:hover { box-shadow: 0 8px 28px rgba(155,77,202,0.15); }

  .card-midlav {
    background: linear-gradient(135deg, #F3EAFA 0%, #E0D0F0 100%);
    border: 1px solid rgba(155,77,202,0.15);
    border-top: 3px solid #9B4DCA;
  }
  .card-midlav:hover { box-shadow: 0 8px 28px rgba(155,77,202,0.18); }

  /* Side blob */
  .asym-side-blob {
    position: absolute;
    bottom: -15%;
    right: -10%;
    width: 160px;
    height: 160px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(199,125,255,0.2) 0%, transparent 70%);
    pointer-events: none;
  }

  .asym-era {
    font-family: var(--font-accent);
    font-size: 0.75rem;
    color: #7B2FBE;
    margin-bottom: 0.875rem;
    position: relative;
    z-index: 1;
  }

  .era-light { color: rgba(199,125,255,0.8) !important; }

  .asym-song {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: clamp(1.625rem, 3vw, 2.25rem);
    line-height: 1.1;
    color: var(--color-text-deep);
    margin-bottom: 0.625rem;
    transition: color 0.2s;
    position: relative;
    z-index: 1;
  }

  .card-lavender:hover .asym-song,
  .card-light:hover .asym-song { color: #9B4DCA; }

  .asym-lyric {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 0.875rem;
    color: rgba(107,91,123,0.5);
    margin-bottom: 0.75rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    position: relative;
    z-index: 1;
    transition: color 0.2s;
  }

  .card-lavender:hover .asym-lyric,
  .card-light:hover .asym-lyric { color: rgba(155,77,202,0.65); }

  .asym-excerpt {
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    position: relative;
    z-index: 1;
  }

  .asym-side-lyric {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    z-index: 1;
  }

  .side-lyric-line {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: clamp(1.125rem, 2.5vw, 1.625rem);
    line-height: 1.4;
    color: #FDFBFF;
  }

  .side-lyric-indent { padding-left: 1.25rem; }

  .asym-side-song {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 0.875rem;
    font-weight: 600;
    color: rgba(199,125,255,0.8);
    margin-top: 1rem;
