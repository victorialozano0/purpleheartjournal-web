---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BlogNav from '../../components/BlogNav.astro';
import BlogCard from '../../components/BlogCard.astro';
import Footer from '../../components/Footer.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<Layout
  title="El diario de una ARMY — Blog | Purple Heart Journal"
  description="Canciones de BTS analizadas como espejos de autoconocimiento. Reflexiones, prompts de journaling y una invitación a escribir lo que sientes."
>
  <BlogNav />

  <!-- Header -->
  <header class="blog-header">
    <div class="header-inner">
      <p class="header-label">El diario de una ARMY</p>
      <h1 class="header-title">Canciones que nos enseñan<br />a conocernos</h1>
      <p class="header-desc">
        No somos un medio de noticias de BTS. Somos ARMY que escribe lo que siente —<br class="hidden md:block" />
        y que encuentra en las canciones el espejo perfecto para hacerlo.
      </p>
    </div>
  </header>

  <!-- Articles grid -->
  <main class="blog-main">
    <div class="max-w-4xl mx-auto">
      {posts.length === 0 ? (
        <p class="empty-state">Próximamente — mientras tanto, escribe lo que sientes. 💜</p>
      ) : (
        <div class="posts-grid">
          {posts.map(post => (
            <BlogCard
              slug={post.id}
              title={post.data.title}
              song={post.data.song}
              album={post.data.album}
              excerpt={post.data.excerpt}
              date={post.data.date}
              tags={post.data.tags}
            />
          ))}
        </div>
      )}
    </div>
  </main>

  <!-- CTA -->
  <section class="blog-cta">
    <div class="max-w-2xl mx-auto text-center px-5">
      <p class="cta-label">¿Quieres escribir con BTS de fondo?</p>
      <h2 class="cta-title">El journal que habla en nuestro idioma</h2>
      <p class="cta-desc">
        85+ prompts de journaling guiados por 35 canciones de BTS.<br />
        Para ARMY que escribe entre canciones.
      </p>
      <a
        href="https://purpleheart.hotmart.com/product/love-yourself-journal"
        class="btn-primary inline-block mt-6"
        target="_blank"
        rel="noopener noreferrer"
      >
        Conoce el journal 💜
      </a>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .blog-header {
    background: linear-gradient(135deg, #1A0A2E 0%, #5B2C8E 60%, #9B4DCA 100%);
    padding: 3rem 1.25rem 4rem;
    position: relative;
    overflow: hidden;
  }

  .blog-header::before {
    content: '';
    position: absolute;
    top: -40%;
    right: -20%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(199, 125, 255, 0.15) 0%, transparent 70%);
    pointer-events: none;
  }

  .header-inner {
    max-width: 48rem;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .back-link {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: rgba(224, 208, 240, 0.7);
    text-decoration: none;
    margin-bottom: 2rem;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--color-purple-heart);
  }

  .header-label {
    font-family: var(--font-accent);
    font-size: 1.5rem;
    color: var(--color-purple-heart);
    margin-bottom: 0.75rem;
  }

  .header-title {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 2.25rem;
    line-height: 1.2;
    color: var(--color-white-glow);
    margin-bottom: 1.25rem;
  }

  @media (min-width: 768px) {
    .blog-header {
      padding: 4rem 1.25rem 5rem;
    }
    .header-title {
      font-size: 3rem;
    }
  }

  .header-desc {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.65;
    color: rgba(224, 208, 240, 0.8);
    max-width: 42rem;
  }

  .blog-main {
    padding: 4rem 1.25rem;
    background: var(--color-white-glow);
  }

  .posts-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .posts-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .empty-state {
    text-align: center;
    font-family: var(--font-body);
    color: var(--color-text-muted);
    padding: 4rem 0;
  }

  .blog-cta {
    background: var(--color-lavender-mist);
    padding: 5rem 0;
    border-top: 1px solid var(--color-soft-lilac);
  }

  .cta-label {
    font-family: var(--font-accent);
    font-size: 1.375rem;
    color: var(--color-purple-heart);
    margin-bottom: 0.75rem;
  }

  .cta-title {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 2rem;
    color: var(--color-text-deep);
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .cta-desc {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  @media (min-width: 768px) {
    .cta-title {
      font-size: 2.5rem;
    }
  }
</style>
