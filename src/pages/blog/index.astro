---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BlogNav from '../../components/BlogNav.astro';
import Footer from '../../components/Footer.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const ERA_SHORT: Record<string, string> = {
  'ARIRANG (2026)':              'ARIRANG 2026',
  'BE (2020)':                   'BE 2020',
  'You Never Walk Alone (2017)': 'YNWA 2017',
  'Love Yourself: Tear (2018)':  'LY: Tear 2018',
};

const era  = (p: typeof posts[0]) => ERA_SHORT[p.data.album] ?? p.data.album.replace(/ \(\d{4}\)$/, '');
const lns  = (p: typeof posts[0]) => p.data.quote?.split(' / ') ?? [];

const COLORS = ['lavender', 'light', 'dark', 'vibrant', 'midlav'] as const;

---

<Layout
  title="El diario de una ARMY — Blog | Purple Heart Journal"
  description="Canciones de BTS analizadas como espejos de autoconocimiento. Reflexiones, prompts de journaling y una invitación a escribir lo que sientes."
>
  <BlogNav />

  <!-- ══ Header ══ -->
  <header class="blog-header">
    <div class="header-inner">
      <div>
        <p class="header-eyebrow">El diario de una ARMY</p>
        <h1 class="header-title">Canciones que <em>nos enseñan</em> a conocernos</h1>
      </div>
      <div class="header-stat" aria-hidden="true">
        <span class="stat-num">{posts.length}</span>
        <span class="stat-label">canciones analizadas</span>
      </div>
    </div>
  </header>

  <!-- ══ GRID ══ -->
  <main class="grid-wrap">
    <div class="cards-grid">
      {/* Card destacada — primera entrada */}
      {posts[0] && (() => {
        const lines = lns(posts[0]);
        return (
          <a href={`/blog/${posts[0].id}`} class="g-card g-card-featured">
            <span class="g-blob" aria-hidden="true" />
            <span class="g-blob g-blob-2" aria-hidden="true" />
            <div class="gf-top">
              <span class="gf-era">{era(posts[0])}</span>
              <span class="gf-badge">Nueva entrada</span>
            </div>
            <span class="gf-giant-quote" aria-hidden="true">"</span>
            <div class="gf-lyric-block">
              {lines.map((l, i) => (
                <p class={`gf-lyric-line ${i > 0 ? 'gf-lyric-indent' : ''}`}>{l}</p>
              ))}
            </div>
            <div class="gf-bottom">
              <div>
                <p class="gf-song">{posts[0].data.song}</p>
                <p class="gf-excerpt">{posts[0].data.excerpt}</p>
              </div>
              <span class="gf-cta">Leer análisis →</span>
            </div>
          </a>
        );
      })()}

      {posts.slice(1).map((post, i) => {
        const color   = COLORS[i % 5];
        const isDark  = color === 'dark' || color === 'vibrant';
        const lines   = lns(post);

        return (
          <a
            href={`/blog/${post.id}`}
            class={`g-card color-${color}`}
          >
            {isDark && <span class="g-blob" aria-hidden="true" />}

            <span class={`g-era ${isDark ? 'g-era-light' : ''}`}>
              {era(post)}
            </span>

            {color === 'dark' ? (
              <>
                <span class="g-overflow-quote" aria-hidden="true">"</span>
                <div class="g-lyric-block">
                  {lines.map((l, li) => (
                    <p class={`g-lyric-line ${li > 0 ? 'g-lyric-indent' : ''}`}>{l}</p>
                  ))}
                </div>
                <div class="g-dark-footer">
                  <p class="g-dark-song">{post.data.song}</p>
                  <span class="g-cta g-cta-dark">Leer →</span>
                </div>
              </>
            ) : (
              <>
                <h2 class={`g-song ${color === 'vibrant' ? 'g-song-light' : ''}`}>
                  {post.data.song}
                </h2>
                {lines[0] && (
                  <p class={`g-lyric-small ${color === 'vibrant' ? 'g-lyric-white' : ''}`}>
                    "{lines[0]}"
                  </p>
                )}
                <p class={`g-excerpt ${color === 'vibrant' ? 'g-excerpt-white' : ''}`}>
                  {post.data.excerpt}
                </p>
                <span class={`g-cta ${color === 'vibrant' ? 'g-cta-white' : ''}`}>Leer →</span>
              </>
            )}
          </a>
        );
      })}
    </div>
  </main>

  <!-- ══ CTA ══ -->
  <section class="blog-cta">
    <div class="cta-inner">
      <p class="cta-eyebrow">¿Quieres escribir con BTS de fondo?</p>
      <h2 class="cta-title">El journal que habla<br/>en nuestro idioma</h2>
      <p class="cta-desc">85+ prompts guiados por 35 canciones de BTS.<br/>Para ARMY que escribe entre canciones.</p>
      <a href="https://pay.hotmart.com/P104306248S" class="cta-btn" target="_blank" rel="noopener noreferrer">
        Conoce el journal 💜
      </a>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* ══ Header ══ */
  .blog-header {
    background: linear-gradient(135deg, #1A0A2E 0%, #3D1278 55%, #9B4DCA 100%);
    padding: 1.75rem 1.5rem 1.625rem;
  }

  .header-inner {
    max-width: 72rem;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .header-eyebrow {
    font-family: var(--font-accent);
    font-size: 1rem;
    color: var(--color-purple-heart);
    margin-bottom: 0.35rem;
  }

  .header-title {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    line-height: 1.15;
    color: #FDFBFF;
  }

  .header-stat { display: none; flex-direction: column; align-items: flex-end; }
  @media (min-width: 600px) { .header-stat { display: flex; } }

  .stat-num {
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 700;
    font-size: clamp(3.5rem, 9vw, 6rem);
    line-height: 0.9;
    color: rgba(199,125,255,0.15);
    letter-spacing: -0.04em;
    user-select: none;
  }

  .stat-label {
    font-family: var(--font-body);
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(199,125,255,0.3);
    text-align: right;
  }

  /* ══ Featured card ══ */
  .g-card-featured {
    grid-column: 1 / -1;
    background: linear-gradient(150deg, #0D051E 0%, #2A0A5E 45%, #6B2FA0 100%);
    min-height: 300px;
    transform: none !important;
    margin-top: 0 !important;
    border: 1px solid rgba(199,125,255,0.18);
    border-top: 3px solid #C77DFF;
    box-shadow:
      0 8px 40px rgba(26,10,46,0.5),
      0 0 0 1px rgba(199,125,255,0.06),
      inset 0 1px 0 rgba(199,125,255,0.08);
  }

  .g-card-featured:hover {
    transform: translateY(-5px) !important;
    box-shadow:
      0 20px 64px rgba(91,44,142,0.55),
      0 0 48px rgba(199,125,255,0.12),
      0 0 0 1px rgba(199,125,255,0.15);
    border-color: rgba(199,125,255,0.3);
    border-top-color: #C77DFF;
  }

  .g-blob-2 {
    position: absolute;
    bottom: -10%; left: 20%;
    width: 180px; height: 180px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(91,44,142,0.35) 0%, transparent 70%);
    pointer-events: none;
  }

  .gf-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
    z-index: 1;
    margin-bottom: 1.25rem;
  }

  .gf-era {
    font-family: var(--font-accent);
    font-size: 0.875rem;
    color: rgba(199,125,255,0.8);
    background: rgba(199,125,255,0.1);
    border: 1px solid rgba(199,125,255,0.22);
    padding: 0.2rem 0.75rem;
    border-radius: 999px;
  }

  .gf-badge {
    font-family: var(--font-body);
    font-size: 0.5625rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #E8C8FF;
    background: rgba(199,125,255,0.2);
    border: 1px solid rgba(199,125,255,0.4);
    padding: 0.2rem 0.625rem;
    border-radius: 999px;
    box-shadow: 0 0 10px rgba(199,125,255,0.2);
  }

  .gf-giant-quote {
    font-family: var(--font-heading);
    font-size: clamp(7rem, 16vw, 14rem);
    line-height: 0.7;
    color: rgba(199,125,255,0.07);
    position: absolute;
    top: 0.25rem; left: 0.75rem;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }

  .gf-lyric-block {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    z-index: 1;
    padding: 0.5rem 0;
  }

  .gf-lyric-line {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: clamp(2rem, 4.5vw, 3.75rem);
    line-height: 1.15;
    color: #FDFBFF;
    letter-spacing: -0.02em;
    text-shadow: 0 2px 24px rgba(199,125,255,0.15);
  }

  .gf-lyric-indent { padding-left: clamp(1rem, 4vw, 4rem); }

  .gf-bottom {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    position: relative;
    z-index: 1;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(199,125,255,0.12);
  }

  .gf-bottom > div { margin-left: auto; text-align: right; }

  .gf-song {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 1rem;
    font-weight: 600;
    color: #C77DFF;
    margin-bottom: 0.25rem;
  }

  .gf-excerpt {
    font-family: 'Poppins', var(--font-body);
    font-size: 0.8125rem;
    line-height: 1.55;
    color: rgba(224,208,240,0.45);
    max-width: 44rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .gf-cta {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    color: rgba(199,125,255,0.55);
    white-space: nowrap;
    flex-shrink: 0;
    transition: color 0.2s, transform 0.2s;
  }

  .g-card-featured:hover .gf-cta { color: #C77DFF; transform: translateX(4px); }

  /* ══ Grid wrap ══ */
  .grid-wrap {
    background: #F3EAFA;
    padding: 2.5rem 1.25rem 5rem;
  }

  @media (min-width: 768px) { .grid-wrap { padding: 3rem 2rem 6rem; } }

  /* ══ Grid ══ */
  .cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    max-width: 72rem;
    margin: 0 auto;
    /* overflow visible para que las rotaciones no se corten */
    overflow: visible;
  }

  @media (min-width: 560px) { .cards-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 900px) { .cards-grid { grid-template-columns: repeat(3, 1fr); } }

  /* ══ Card base ══ */
  .g-card {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: 1.25rem;
    padding: 1.5rem;
    text-decoration: none;
    overflow: hidden;
    cursor: pointer;
    min-height: 220px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  /* Patrón de 5 rotaciones + margin-top que se repite */
  .g-card:nth-child(5n+1) { transform: rotate(-1.2deg); }
  .g-card:nth-child(5n+2) { transform: rotate(0.7deg);  margin-top: 0.75rem; }
  .g-card:nth-child(5n+3) { transform: rotate(-0.5deg); margin-top: 1.5rem; }
  .g-card:nth-child(5n+4) { transform: rotate(0.9deg);  margin-top: 0.25rem; }
  .g-card:nth-child(5n+5) { transform: rotate(-0.8deg); margin-top: 1rem; }

  /* Sin rotaciones en móvil */
  @media (max-width: 559px) {
    .g-card { transform: none !important; margin-top: 0 !important; }
  }

  .g-card:hover {
    transform: rotate(0deg) translateY(-5px) !important;
    z-index: 2;
  }

  /* ── Colores ── */
  .color-dark {
    background: linear-gradient(145deg, #1A0A2E 0%, #3B1066 55%, #6B2FA0 100%);
    box-shadow: 0 4px 20px rgba(26,10,46,0.32);
  }
  .color-dark:hover { box-shadow: 0 14px 40px rgba(91,44,142,0.5); }

  .color-vibrant {
    background: linear-gradient(145deg, #7B2FBE 0%, #9B4DCA 50%, #C77DFF 100%);
    box-shadow: 0 4px 20px rgba(155,77,202,0.3);
  }
  .color-vibrant:hover { box-shadow: 0 14px 40px rgba(199,125,255,0.45); }

  .color-lavender {
    background: #EAD8F8;
    border: 1px solid rgba(199,125,255,0.2);
    border-top: 3px solid #C77DFF;
    box-shadow: 0 2px 10px rgba(199,125,255,0.08);
  }
  .color-lavender:hover { box-shadow: 0 10px 32px rgba(199,125,255,0.22); border-color: rgba(199,125,255,0.4); }

  .color-light {
    background: #FDFBFF;
    border: 1px solid #E0D0F0;
    border-top: 3px solid #9B4DCA;
    box-shadow: 0 2px 10px rgba(107,91,123,0.07);
  }
  .color-light:hover { box-shadow: 0 10px 32px rgba(155,77,202,0.15); border-color: rgba(155,77,202,0.3); }

  .color-midlav {
    background: linear-gradient(135deg, #F3EAFA 0%, #E0D0F0 100%);
    border: 1px solid rgba(155,77,202,0.15);
    border-top: 3px solid #9B4DCA;
    box-shadow: 0 2px 10px rgba(107,91,123,0.06);
  }
  .color-midlav:hover { box-shadow: 0 10px 32px rgba(155,77,202,0.18); }

  /* ── Decorative blob ── */
  .g-blob {
    position: absolute;
    bottom: -15%; right: -8%;
    width: 150px; height: 150px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(199,125,255,0.2) 0%, transparent 70%);
    pointer-events: none;
  }

  /* ── Era ── */
  .g-era {
    font-family: var(--font-accent);
    font-size: 0.6875rem;
    color: #7B2FBE;
    margin-bottom: 0.625rem;
    position: relative;
    z-index: 1;
    flex-shrink: 0;
  }

  .g-era-light { color: rgba(199,125,255,0.8); }

  /* ── Dark card ── */
  .g-overflow-quote {
    font-family: var(--font-heading);
    font-size: 5rem;
    line-height: 0.55;
    color: rgba(199,125,255,0.18);
    display: block;
    margin-left: -0.2rem;
    margin-bottom: 0.35rem;
    user-select: none;
    flex-shrink: 0;
    position: relative;
    z-index: 1;
  }

  .g-lyric-block {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    z-index: 1;
  }

  .g-lyric-line {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: clamp(1.125rem, 2.2vw, 1.625rem);
    line-height: 1.45;
    color: #FDFBFF;
  }

  .g-lyric-indent { padding-left: 1rem; }

  .g-dark-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 1.25rem;
    padding-top: 0.875rem;
    border-top: 1px solid rgba(199,125,255,0.15);
    position: relative;
    z-index: 1;
  }

  .g-dark-song {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 0.9375rem;
    font-weight: 600;
    color: #C77DFF;
  }

  /* ── Song name ── */
  .g-song {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: clamp(1.625rem, 2.8vw, 2.25rem);
    line-height: 1.1;
    color: var(--color-text-deep);
    margin-bottom: 0.375rem;
    transition: color 0.2s;
    position: relative;
    z-index: 1;
  }

  .g-song-light { color: #FDFBFF; }

  .color-light:hover .g-song,
  .color-lavender:hover .g-song,
  .color-midlav:hover .g-song { color: #9B4DCA; }

  .color-vibrant:hover .g-song-light { color: #E8C8FF; }

  /* ── Lyric small ── */
  .g-lyric-small {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: clamp(1.375rem, 2.2vw, 1.75rem);
    line-height: 1.4;
    color: rgba(107,91,123,0.75);
    margin-bottom: 0.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.2s;
    position: relative;
    z-index: 1;
  }

  .g-lyric-white { color: rgba(253,251,255,0.6); }

  .color-light:hover .g-lyric-small,
  .color-lavender:hover .g-lyric-small,
  .color-midlav:hover .g-lyric-small { color: rgba(155,77,202,0.65); }

  /* ── Excerpt ── */
  .g-excerpt {
    font-family: 'Poppins', var(--font-body);
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    position: relative;
    z-index: 1;
  }

  .g-excerpt-white { color: rgba(253,251,255,0.6); }

  /* ── CTAs ── */
  .g-cta {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    color: rgba(107,91,123,0.4);
    margin-top: 1rem;
    align-self: flex-end;
    transition: color 0.2s, transform 0.2s;
    position: relative;
    z-index: 1;
  }

  .g-cta-dark  { color: rgba(199,125,255,0.45); }
  .g-cta-white { color: rgba(253,251,255,0.45); }

  .color-light:hover .g-cta,
  .color-lavender:hover .g-cta,
  .color-midlav:hover .g-cta { color: #9B4DCA; transform: translateX(4px); }

  .color-dark:hover .g-cta-dark   { color: #C77DFF; transform: translateX(4px); }
  .color-vibrant:hover .g-cta-white { color: #FDFBFF; transform: translateX(4px); }

  /* ══ CTA ══ */
  .blog-cta {
    background: linear-gradient(135deg, #1A0A2E 0%, #3B1066 100%);
    padding: 4.5rem 1.5rem;
    position: relative;
    overflow: hidden;
  }

  .blog-cta::before {
    content: '';
    position: absolute;
    top: -30%; left: -10%;
    width: 500px; height: 500px;
    background: radial-gradient(circle, rgba(199,125,255,0.07) 0%, transparent 70%);
    pointer-events: none;
  }

  .cta-inner {
    max-width: 36rem;
    margin: 0 auto;
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .cta-eyebrow {
    font-family: var(--font-accent);
    font-size: 1.25rem;
    color: var(--color-purple-heart);
    margin-bottom: 0.75rem;
  }

  .cta-title {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    color: #FDFBFF;
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .cta-desc {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.7;
    color: rgba(224,208,240,0.65);
    margin-bottom: 2rem;
  }

  .cta-btn {
    display: inline-block;
    background: linear-gradient(135deg, #9B4DCA, #C77DFF);
    color: #FDFBFF;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1rem;
    padding: 0.9rem 2rem;
    border-radius: 0.75rem;
    text-decoration: none;
    transition: box-shadow 0.3s, transform 0.3s;
    box-shadow: 0 0 24px rgba(199,125,255,0.28);
    cursor: pointer;
  }

  .cta-btn:hover {
    box-shadow: 0 0 40px rgba(199,125,255,0.5);
    transform: translateY(-2px);
  }
</style>
