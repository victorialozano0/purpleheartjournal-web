---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BlogNav from '../../components/BlogNav.astro';
import Footer from '../../components/Footer.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const ERA_SHORT: Record<string, string> = {
  'ARIRANG (2026)':              'ARIRANG 2026',
  'BE (2020)':                   'BE 2020',
  'You Never Walk Alone (2017)': 'YNWA 2017',
  'Love Yourself: Tear (2018)':  'LY: Tear 2018',
};

const era  = (p: typeof posts[0]) => ERA_SHORT[p.data.album] ?? p.data.album.replace(/ \(\d{4}\)$/, '');
const lns  = (p: typeof posts[0]) => p.data.quote?.split(' / ') ?? [];

// Marquee text
const marqueeText = posts
  .filter(p => p.data.quote)
  .slice(0, 6)
  .map(p => p.data.quote!.split(' / ')[0])
  .join('  ·  ');

// Grupos de cards (post 0 va al héroe)
const groups = [
  posts.slice(1, 4),
  posts.slice(4, 7),
  posts.slice(7, 10),
  posts.slice(10, 13),
  posts.slice(13),
];

// Rotaciones y márgenes por grupo/posición
const ROTATIONS = [
  ['-1.5deg', '0.8deg', '-0.6deg'],
  ['1deg',   '-1.2deg', '0.5deg'],
  ['-0.8deg', '1.5deg', '-1deg'],
  ['0.6deg', '-0.8deg', '1.2deg'],
  ['-1.2deg', '0.5deg', '-0.7deg', '0.9deg'],
];

const MARGINS = [
  ['1.5rem', '0',     '2.5rem'],
  ['0',      '2rem',  '0.5rem'],
  ['2rem',   '0',     '1.5rem'],
  ['0.5rem', '1.5rem','0'],
  ['1rem',   '0',     '1.5rem', '0.5rem'],
];

// Colores por grupo/posición
const COLORS = [
  ['lavender', 'light',   'dark'],
  ['vibrant',  'lavender','light'],
  ['light',    'dark',    'lavender'],
  ['lavender', 'vibrant', 'light'],
  ['dark',     'light',   'lavender', 'midlav'],
];

// Labels de sección
const LABELS = [
  'desde el principio',
  'seguir leyendo',
  'mientras tanto',
  'para cuando quieras',
  'y también estas',
];
---

<Layout
  title="El diario de una ARMY — Blog | Purple Heart Journal"
  description="Canciones de BTS analizadas como espejos de autoconocimiento. Reflexiones, prompts de journaling y una invitación a escribir lo que sientes."
>
  <BlogNav />

  <!-- ══ Header ══ -->
  <header class="blog-header">
    <div class="header-inner">
      <div>
        <p class="header-eyebrow">El diario de una ARMY</p>
        <h1 class="header-title">Canciones que <em>nos enseñan</em> a conocernos</h1>
      </div>
      <div class="header-stat" aria-hidden="true">
        <span class="stat-num">{posts.length}</span>
        <span class="stat-label">canciones analizadas</span>
      </div>
    </div>
  </header>

  <!-- ══ HÉROE ══ -->
  {posts[0] && (
    <a href={`/blog/${posts[0].id}`} class="hero-post">
      <span class="hero-blob" aria-hidden="true" />
      <span class="hero-blob hero-blob-2" aria-hidden="true" />

      <div class="hero-top">
        <span class="hero-era-pill">{era(posts[0])}</span>
        <span class="hero-count">01 / {String(posts.length).padStart(2,'0')}</span>
      </div>

      <span class="hero-giant-quote" aria-hidden="true">"</span>

      <div class="hero-lyric-block">
        {lns(posts[0]).map((l, i) => (
          <p class={`hero-lyric-line ${i > 0 ? 'hero-lyric-indent' : ''}`}>{l}</p>
        ))}
      </div>

      <div class="hero-bottom">
        <div>
          <p class="hero-song">{posts[0].data.song}</p>
          <p class="hero-excerpt">{posts[0].data.excerpt}</p>
        </div>
        <span class="hero-cta">Leer análisis <span class="arrow-long">→</span></span>
      </div>
    </a>
  )}

  <!-- ══ MARQUEE ══ -->
  <div class="marquee-strip" aria-hidden="true">
    <div class="marquee-track">
      <span class="marquee-text">{marqueeText} &nbsp;&nbsp;&nbsp;</span>
      <span class="marquee-text">{marqueeText} &nbsp;&nbsp;&nbsp;</span>
    </div>
  </div>

  <!-- ══ CLUSTERS ══ -->
  <div class="clusters-wrap">
    {groups.map((group, gi) => (
      <section class="cluster-section">
        <p class="cluster-label">{LABELS[gi]}</p>
        <div class="cluster-row">
          {group.map((post, ci) => {
            const color = COLORS[gi]?.[ci] ?? 'light';
            const rot   = ROTATIONS[gi]?.[ci] ?? '0deg';
            const mt    = MARGINS[gi]?.[ci] ?? '0';
            const lines = lns(post);
            const isDark = color === 'dark' || color === 'vibrant';

            return (
              <a
                href={`/blog/${post.id}`}
                class={`c-card color-${color}`}
                style={`--rot:${rot}; --mt:${mt};`}
              >
                {isDark && <span class="c-blob" aria-hidden="true" />}

                <span class={`c-era ${isDark ? 'c-era-light' : ''}`}>
                  {era(post)}
                </span>

                {color === 'dark' ? (
                  /* Dark: lírica hero */
                  <>
                    <span class="c-overflow-quote" aria-hidden="true">"</span>
                    <div class="c-lyric-block">
                      {lines.map((l, li) => (
                        <p class={`c-lyric-line ${li > 0 ? 'c-lyric-indent' : ''}`}>{l}</p>
                      ))}
                    </div>
                    <div class="c-dark-footer">
                      <p class="c-dark-song">{post.data.song}</p>
                      <span class="c-cta c-cta-dark">Leer →</span>
                    </div>
                  </>
                ) : color === 'vibrant' ? (
                  /* Vibrant: canción + lírica en blanco */
                  <>
                    <h2 class="c-song c-song-light">{post.data.song}</h2>
                    {lines[0] && (
                      <p class="c-lyric-small c-lyric-white">"{lines[0]}"</p>
                    )}
                    <p class="c-excerpt c-excerpt-white">{post.data.excerpt}</p>
                    <span class="c-cta c-cta-white">Leer →</span>
                  </>
                ) : (
                  /* Light / lavender / midlav */
                  <>
                    <h2 class="c-song">{post.data.song}</h2>
                    {lines[0] && (
                      <p class="c-lyric-small">"{lines[0]}"</p>
                    )}
                    <p class="c-excerpt">{post.data.excerpt}</p>
                    <span class="c-cta">Leer →</span>
                  </>
                )}
              </a>
            );
          })}
        </div>
      </section>
    ))}
  </div>

  <!-- ══ CTA ══ -->
  <section class="blog-cta">
    <div class="cta-inner">
      <p class="cta-eyebrow">¿Quieres escribir con BTS de fondo?</p>
      <h2 class="cta-title">El journal que habla<br/>en nuestro idioma</h2>
      <p class="cta-desc">85+ prompts guiados por 35 canciones de BTS.<br/>Para ARMY que escribe entre canciones.</p>
      <a href="https://pay.hotmart.com/P104306248S" class="cta-btn" target="_blank" rel="noopener noreferrer">
        Conoce el journal 💜
      </a>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* ══ Header ══ */
  .blog-header {
    background: linear-gradient(135deg, #1A0A2E 0%, #3D1278 55%, #9B4DCA 100%);
    padding: 1.75rem 1.5rem 1.625rem;
  }

  .header-inner {
    max-width: 72rem;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .header-eyebrow {
    font-family: var(--font-accent);
    font-size: 1rem;
    color: var(--color-purple-heart);
    margin-bottom: 0.35rem;
  }

  .header-title {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    line-height: 1.15;
    color: #FDFBFF;
  }

  .header-stat { display: none; flex-direction: column; align-items: flex-end; }
  @media (min-width: 600px) { .header-stat { display: flex; } }

  .stat-num {
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 700;
    font-size: clamp(3.5rem, 9vw, 6rem);
    line-height: 0.9;
    color: rgba(199,125,255,0.15);
    letter-spacing: -0.04em;
    user-select: none;
  }

  .stat-label {
    font-family: var(--font-body);
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(199,125,255,0.3);
    text-align: right;
  }

  /* ══ Héroe ══ */
  .hero-post {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    background: linear-gradient(150deg, #0D051E 0%, #2A0A5E 45%, #5B2C8E 100%);
    padding: 3rem 1.75rem 2.5rem;
    text-decoration: none;
    overflow: hidden;
    cursor: pointer;
    min-height: 52vh;
    transition: filter 0.3s;
  }

  @media (min-width: 768px) { .hero-post { padding: 3.5rem 5vw 3rem; min-height: 58vh; } }

  .hero-post:hover { filter: brightness(1.07); }

  .hero-blob {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }

  .hero-blob:first-of-type {
    width: 55vw; height: 55vw;
    max-width: 600px; max-height: 600px;
    top: -20%; right: -10%;
    background: radial-gradient(circle, rgba(199,125,255,0.15) 0%, transparent 65%);
  }

  .hero-blob-2 {
    width: 30vw; height: 30vw;
    max-width: 320px; max-height: 320px;
    bottom: -10%; left: 15%;
    background: radial-gradient(circle, rgba(91,44,142,0.4) 0%, transparent 70%);
  }

  .hero-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
    z-index: 1;
    margin-bottom: 1.5rem;
  }

  .hero-era-pill {
    font-family: var(--font-accent);
    font-size: 0.875rem;
    color: rgba(199,125,255,0.8);
    background: rgba(199,125,255,0.12);
    border: 1px solid rgba(199,125,255,0.25);
    padding: 0.2rem 0.75rem;
    border-radius: 999px;
  }

  .hero-count {
    font-family: var(--font-body);
    font-size: 0.625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(199,125,255,0.3);
  }

  .hero-giant-quote {
    font-family: var(--font-heading);
    font-size: clamp(10rem, 22vw, 18rem);
    line-height: 0.7;
    color: rgba(199,125,255,0.08);
    position: absolute;
    top: 0.5rem; left: 1rem;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }

  .hero-lyric-block {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    z-index: 1;
    padding: 1rem 0;
  }

  .hero-lyric-line {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: clamp(2rem, 5.5vw, 4.5rem);
    line-height: 1.15;
    color: #FDFBFF;
    letter-spacing: -0.02em;
  }

  .hero-lyric-indent { padding-left: clamp(1rem, 5vw, 5rem); }

  .hero-bottom {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    position: relative;
    z-index: 1;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(199,125,255,0.12);
  }

  .hero-song {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 1rem;
    font-weight: 600;
    color: #C77DFF;
    margin-bottom: 0.3rem;
  }

  .hero-excerpt {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    line-height: 1.55;
    color: rgba(224,208,240,0.4);
    max-width: 38rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .hero-cta {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    color: rgba(199,125,255,0.6);
    white-space: nowrap;
    flex-shrink: 0;
    transition: color 0.2s;
  }

  .hero-post:hover .hero-cta { color: #C77DFF; }

  .arrow-long {
    display: inline-block;
    transition: transform 0.25s;
  }

  .hero-post:hover .arrow-long { transform: translateX(6px); }

  /* ══ Marquee ══ */
  .marquee-strip {
    background: #9B4DCA;
    padding: 0.75rem 0;
    overflow: hidden;
    white-space: nowrap;
  }

  .marquee-track {
    display: inline-flex;
    animation: scroll-left 28s linear infinite;
  }

  .marquee-text {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 0.9375rem;
    color: rgba(253,251,255,0.7);
    padding-right: 2rem;
    letter-spacing: 0.02em;
  }

  @keyframes scroll-left {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  /* ══ Clusters wrapper ══ */
  .clusters-wrap {
    background: #F3EAFA;
    padding: 0.5rem 0 5rem;
  }

  /* ══ Cluster section ══ */
  .cluster-section {
    padding: 1.25rem 1.25rem 0.25rem;
    max-width: 80rem;
    margin: 0 auto;
  }

  @media (min-width: 768px) { .cluster-section { padding: 1.5rem 2rem 0.25rem; } }

  .cluster-label {
    font-family: var(--font-accent);
    font-size: 1rem;
    color: rgba(107,91,123,0.35);
    text-align: center;
    margin-bottom: 0.875rem;
  }

  .cluster-row {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    flex-direction: column;
  }

  @media (min-width: 580px) { .cluster-row { flex-direction: row; } }

  /* ══ Card base ══ */
  .c-card {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: 1.25rem;
    padding: 1.5rem;
    text-decoration: none;
    overflow: hidden;
    cursor: pointer;
    flex: 1;
    min-height: 220px;
    /* Rotación y margen superiror vía CSS custom props */
    transform: rotate(var(--rot, 0deg));
    margin-top: var(--mt, 0);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  /* En móvil, sin rotaciones */
  @media (max-width: 579px) {
    .c-card { transform: none !important; margin-top: 0 !important; }
  }

  .c-card:hover {
    transform: rotate(0deg) translateY(-5px) !important;
    z-index: 2;
  }

  /* ── Colores ── */
  .color-dark {
    background: linear-gradient(145deg, #1A0A2E 0%, #3B1066 55%, #6B2FA0 100%);
    box-shadow: 0 4px 20px rgba(26,10,46,0.32);
  }
  .color-dark:hover { box-shadow: 0 14px 40px rgba(91,44,142,0.5); }

  .color-vibrant {
    background: linear-gradient(145deg, #7B2FBE 0%, #9B4DCA 50%, #C77DFF 100%);
    box-shadow: 0 4px 20px rgba(155,77,202,0.3);
  }
  .color-vibrant:hover { box-shadow: 0 14px 40px rgba(199,125,255,0.45); }

  .color-lavender {
    background: #EAD8F8;
    border: 1px solid rgba(199,125,255,0.2);
    border-top: 3px solid #C77DFF;
    box-shadow: 0 2px 10px rgba(199,125,255,0.08);
  }
  .color-lavender:hover { box-shadow: 0 10px 32px rgba(199,125,255,0.22); border-color: rgba(199,125,255,0.4); }

  .color-light {
    background: #FDFBFF;
    border: 1px solid #E0D0F0;
    border-top: 3px solid #9B4DCA;
    box-shadow: 0 2px 10px rgba(107,91,123,0.07);
  }
  .color-light:hover { box-shadow: 0 10px 32px rgba(155,77,202,0.15); border-color: rgba(155,77,202,0.3); }

  .color-midlav {
    background: linear-gradient(135deg, #F3EAFA 0%, #E0D0F0 100%);
    border: 1px solid rgba(155,77,202,0.15);
    border-top: 3px solid #9B4DCA;
    box-shadow: 0 2px 10px rgba(107,91,123,0.06);
  }
  .color-midlav:hover { box-shadow: 0 10px 32px rgba(155,77,202,0.18); }

  /* ── Blob decorativo en cards oscuras ── */
  .c-blob {
    position: absolute;
    bottom: -15%; right: -8%;
    width: 160px; height: 160px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(199,125,255,0.2) 0%, transparent 70%);
    pointer-events: none;
  }

  /* ── Era pill ── */
  .c-era {
    font-family: var(--font-accent);
    font-size: 0.75rem;
    color: #7B2FBE;
    margin-bottom: 0.875rem;
    position: relative;
    z-index: 1;
    flex-shrink: 0;
  }

  .c-era-light { color: rgba(199,125,255,0.8); }

  /* ── Dark card content ── */
  .c-overflow-quote {
    font-family: var(--font-heading);
    font-size: 5rem;
    line-height: 0.55;
    color: rgba(199,125,255,0.18);
    display: block;
    margin-left: -0.2rem;
    margin-bottom: 0.35rem;
    user-select: none;
    flex-shrink: 0;
    position: relative;
    z-index: 1;
  }

  .c-lyric-block {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    z-index: 1;
  }

  .c-lyric-line {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: clamp(1.125rem, 2.2vw, 1.625rem);
    line-height: 1.45;
    color: #FDFBFF;
  }

  .c-lyric-indent { padding-left: 1rem; }

  .c-dark-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 1.25rem;
    padding-top: 0.875rem;
    border-top: 1px solid rgba(199,125,255,0.15);
    position: relative;
    z-index: 1;
  }

  .c-dark-song {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 0.9375rem;
    font-weight: 600;
    color: #C77DFF;
  }

  /* ── Song hero (light / lavender / vibrant / midlav) ── */
  .c-song {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: clamp(1.375rem, 2.5vw, 2rem);
    line-height: 1.1;
    color: var(--color-text-deep);
    margin-bottom: 0.5rem;
    transition: color 0.2s;
    position: relative;
    z-index: 1;
  }

  .c-song-light { color: #FDFBFF; }

  .color-light:hover .c-song,
  .color-lavender:hover .c-song,
  .color-midlav:hover .c-song { color: #9B4DCA; }

  .color-vibrant:hover .c-song-light { color: #E8C8FF; }

  /* ── Lyric quote (small) ── */
  .c-lyric-small {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 0.875rem;
    line-height: 1.5;
    color: rgba(107,91,123,0.5);
    margin-bottom: 0.625rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.2s;
    position: relative;
    z-index: 1;
  }

  .c-lyric-white { color: rgba(253,251,255,0.6); }

  .color-light:hover .c-lyric-small,
  .color-lavender:hover .c-lyric-small,
  .color-midlav:hover .c-lyric-small { color: rgba(155,77,202,0.65); }

  /* ── Excerpt ── */
  .c-excerpt {
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    position: relative;
    z-index: 1;
  }

  .c-excerpt-white { color: rgba(253,251,255,0.6); }

  /* ── CTA ── */
  .c-cta {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    color: rgba(107,91,123,0.4);
    margin-top: 1rem;
    align-self: flex-end;
    transition: color 0.2s, transform 0.2s;
    position: relative;
    z-index: 1;
  }

  .c-cta-dark { color: rgba(199,125,255,0.45); }
  .c-cta-white { color: rgba(253,251,255,0.45); }

  .color-light:hover .c-cta,
  .color-lavender:hover .c-cta,
  .color-midlav:hover .c-cta { color: #9B4DCA; transform: translateX(4px); }

  .color-dark:hover .c-cta-dark { color: #C77DFF; transform: translateX(4px); }
  .color-vibrant:hover .c-cta-white { color: #FDFBFF; transform: translateX(4px); }

  /* ══ CTA section ══ */
  .blog-cta {
    background: linear-gradient(135deg, #1A0A2E 0%, #3B1066 100%);
    padding: 4.5rem 1.5rem;
    position: relative;
    overflow: hidden;
  }

  .blog-cta::before {
    content: '';
    position: absolute;
    top: -30%; left: -10%;
    width: 500px; height: 500px;
    background: radial-gradient(circle, rgba(199,125,255,0.07) 0%, transparent 70%);
    pointer-events: none;
  }

  .cta-inner {
    max-width: 36rem;
    margin: 0 auto;
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .cta-eyebrow {
    font-family: var(--font-accent);
    font-size: 1.25rem;
    color: var(--color-purple-heart);
