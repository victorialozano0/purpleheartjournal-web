---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BlogNav from '../../components/BlogNav.astro';
import BlogCard from '../../components/BlogCard.astro';
import Footer from '../../components/Footer.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const byAlbum: Record<string, typeof posts> = {};
for (const post of posts) {
  const album = post.data.album;
  if (!byAlbum[album]) byAlbum[album] = [];
  byAlbum[album].push(post);
}

const albumOrder = [
  'ARIRANG (2026)',
  'BE (2020)',
  'You Never Walk Alone (2017)',
  'Love Yourself: Tear (2018)',
];

const [featured, ...rest] = posts;
---

<Layout
  title="El diario de una ARMY — Blog | Purple Heart Journal"
  description="Canciones de BTS analizadas como espejos de autoconocimiento. Reflexiones, prompts de journaling y una invitación a escribir lo que sientes."
>
  <BlogNav />

  <!-- Header asimétrico -->
  <header class="blog-header">
    <div class="header-inner">
      <div class="header-left">
        <p class="header-eyebrow">El diario de una ARMY</p>
        <h1 class="header-title">Canciones que<br /><em>nos enseñan</em><br />a conocernos</h1>
        <p class="header-desc">
          No somos un medio de noticias de BTS. Somos ARMY que escribe lo que siente
          y que encuentra en las canciones el espejo perfecto para hacerlo.
        </p>
      </div>
      <div class="header-right" aria-hidden="true">
        <span class="header-count-num">{posts.length}</span>
        <span class="header-count-label">canciones<br/>analizadas</span>
      </div>
    </div>
  </header>

  <!-- Separador editorial -->
  <div class="section-divider">
    <span class="divider-line"></span>
    <span class="divider-text">— {posts.length} entradas —</span>
    <span class="divider-line"></span>
  </div>

  <!-- Mobile song strip -->
  <div class="mobile-strip" aria-label="Índice de entradas">
    {posts.map(post => (
      <a href={`/blog/${post.id}`} class="mobile-pill">{post.data.song}</a>
    ))}
  </div>

  <!-- Layout: main izquierda, índice derecha -->
  <div class="blog-layout">

    <!-- Main content -->
    <main class="blog-main">

      <!-- Featured: canción como héroe tipográfico -->
      {featured && (
        <a href={`/blog/${featured.id}`} class="featured-card">
          <div class="featured-banner">
            <span class="featured-badge">Nueva entrada</span>
            <p class="featured-song-giant">{featured.data.song}</p>
            <p class="featured-album-tag">{featured.data.album}</p>
            <div class="featured-glow" aria-hidden="true"></div>
          </div>
          <div class="featured-body">
            <div class="featured-body-text">
              <h2 class="featured-title">{featured.data.title}</h2>
              <p class="featured-excerpt">{featured.data.excerpt}</p>
            </div>
            <span class="featured-cta">Leer artículo →</span>
          </div>
        </a>
      )}

      <!-- Grid del resto de artículos -->
      {rest.length > 0 && (
        <div class="posts-grid">
          {rest.map(post => (
            <BlogCard
              slug={post.id}
              title={post.data.title}
              song={post.data.song}
              album={post.data.album}
              excerpt={post.data.excerpt}
              date={post.data.date}
              tags={post.data.tags}
            />
          ))}
        </div>
      )}

    </main>

    <!-- Índice editorial — derecha -->
    <aside class="blog-index" aria-label="Índice de artículos">
      <div class="index-inner">

        <div class="index-header">
          <span class="index-label-vertical">ÍNDICE</span>
          <div class="index-meta">
            <span class="index-brand">Purple Heart Journal</span>
            <span class="index-tagline">{posts.length} canciones<br/>para conocerte</span>
          </div>
        </div>

        {albumOrder.map(album => byAlbum[album] && (
          <div class="index-album">
            <div class="index-album-header">
              <span class="index-album-year">{album.match(/\((\d+)\)/)?.[1]}</span>
              <span class="index-album-title">
                {album.replace(/ \(\d{4}\)$/, '')}
              </span>
            </div>
            <ul class="index-list">
              {byAlbum[album].map(post => (
                <li>
                  <a href={`/blog/${post.id}`} class="index-link">
                    {post.data.song}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}

        <div class="index-footer">
          <span>💜 Para ARMY que escribe entre canciones</span>
        </div>

      </div>
    </aside>

  </div>

  <!-- CTA -->
  <section class="blog-cta">
    <div class="cta-inner">
      <p class="cta-label">¿Quieres escribir con BTS de fondo?</p>
      <h2 class="cta-title">El journal que habla en nuestro idioma</h2>
      <p class="cta-desc">
        85+ prompts de journaling guiados por 35 canciones de BTS.<br />
        Para ARMY que escribe entre canciones.
      </p>
      <a
        href="https://pay.hotmart.com/P104306248S"
        class="cta-btn"
        target="_blank"
        rel="noopener noreferrer"
      >
        Conoce el journal 💜
      </a>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* ── Header asimétrico ── */
  .blog-header {
    background: linear-gradient(135deg, #1A0A2E 0%, #3D1278 55%, #9B4DCA 100%);
    padding: 4.5rem 1.5rem 4rem;
    position: relative;
    overflow: hidden;
  }

  .blog-header::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 80% 50%, rgba(199,125,255,0.1) 0%, transparent 60%);
    pointer-events: none;
  }

  .header-inner {
    max-width: 72rem;
    margin: 0 auto;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    position: relative;
    z-index: 1;
  }

  .header-left { flex: 1; }

  .header-eyebrow {
    font-family: var(--font-accent);
    font-size: 0.8125rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-purple-heart);
    margin-bottom: 1.25rem;
  }

  .header-title {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: clamp(2.25rem, 5vw, 4rem);
    line-height: 1.08;
    color: #FDFBFF;
    margin-bottom: 1.5rem;
  }

  .header-desc {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.75;
    color: rgba(224, 208, 240, 0.65);
    max-width: 36rem;
  }

  /* Número fantasma decorativo */
  .header-right {
    display: none;
    flex-direction: column;
    align-items: flex-end;
    flex-shrink: 0;
    padding-bottom: 0.5rem;
  }

  @media (min-width: 600px) {
    .header-right { display: flex; }
  }

  .header-count-num {
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 700;
    font-size: clamp(6rem, 14vw, 10rem);
    line-height: 0.9;
    color: rgba(199, 125, 255, 0.13);
    letter-spacing: -0.04em;
    user-select: none;
  }

  .header-count-label {
    font-family: var(--font-body);
    font-size: 0.5625rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(199, 125, 255, 0.35);
    text-align: right;
    line-height: 1.6;
    margin-top: 0.25rem;
  }

  /* ── Separador editorial ── */
  .section-divider {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem 2rem;
    background: #FDFBFF;
    border-bottom: 1px solid var(--color-soft-lilac);
  }

  .divider-line {
    flex: 1;
    height: 1px;
    background: var(--color-soft-lilac);
  }

  .divider-text {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 0.8125rem;
    color: rgba(107, 91, 123, 0.45);
    letter-spacing: 0.06em;
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* ── Mobile strip ── */
  .mobile-strip {
    display: flex;
    overflow-x: auto;
    gap: 0.5rem;
    padding: 0.875rem 1.25rem;
    background: #FDFBFF;
    border-bottom: 1px solid var(--color-soft-lilac);
    scrollbar-width: none;
  }

  .mobile-strip::-webkit-scrollbar { display: none; }

  @media (min-width: 900px) {
    .mobile-strip { display: none; }
  }

  .mobile-pill {
    flex-shrink: 0;
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 0.875rem;
    color: var(--color-purple-deep);
    text-decoration: none;
    background: var(--color-lavender-mist);
    border: 1px solid rgba(199, 125, 255, 0.2);
    padding: 0.3rem 0.875rem;
    border-radius: 999px;
    white-space: nowrap;
    transition: background 0.2s, border-color 0.2s;
    cursor: pointer;
  }

  .mobile-pill:hover {
    background: rgba(199, 125, 255, 0.14);
    border-color: var(--color-purple-heart);
  }

  /* ── Layout: main + índice ── */
  .blog-layout {
    display: flex;
    align-items: flex-start;
    background: #FDFBFF;
    min-height: 60vh;
  }

  /* ── Main ── */
  .blog-main {
    flex: 1;
    min-width: 0;
    padding: 2.5rem 1.5rem 5rem;
  }

  @media (min-width: 768px) {
    .blog-main { padding: 3rem 2.25rem 5rem; }
  }

  /* ── Featured card: canción como héroe ── */
  .featured-card {
    display: block;
    text-decoration: none;
    border-radius: 0.875rem;
    overflow: hidden;
    margin-bottom: 2.5rem;
    cursor: pointer;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    border: 1px solid rgba(199, 125, 255, 0.15);
  }

  .featured-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 20px 56px rgba(199, 125, 255, 0.22);
  }

  .featured-banner {
    background: linear-gradient(150deg, #1A0A2E 0%, #4A1585 65%, #9B4DCA 100%);
    padding: 3rem 2.5rem 2.5rem;
    position: relative;
    overflow: hidden;
  }

  .featured-badge {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-purple-heart);
    background: rgba(199, 125, 255, 0.12);
    border: 1px solid rgba(199, 125, 255, 0.3);
    padding: 0.2rem 0.625rem;
    border-radius: 999px;
    margin-bottom: 1.5rem;
    position: relative;
    z-index: 1;
  }

  .featured-song-giant {
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 600;
    font-size: clamp(2.75rem, 7vw, 5rem);
    line-height: 0.95;
    color: #FDFBFF;
    letter-spacing: -0.025em;
    position: relative;
    z-index: 1;
    margin-bottom: 1rem;
  }

  .featured-album-tag {
    font-family: var(--font-body);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(199, 125, 255, 0.6);
    position: relative;
    z-index: 1;
  }

  .featured-glow {
    position: absolute;
    bottom: -25%;
    right: -8%;
    width: 320px;
    height: 320px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(199,125,255,0.22) 0%, transparent 70%);
    pointer-events: none;
  }

  .featured-body {
    background: #FDFBFF;
    border-top: 3px solid var(--color-purple-heart);
    padding: 1.75rem 2.5rem 2rem;
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .featured-body-text {
    flex: 1;
    min-width: 220px;
  }

  .featured-title {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: clamp(1.125rem, 2.5vw, 1.4375rem);
    line-height: 1.3;
    color: var(--color-text-deep);
    margin-bottom: 0.625rem;
  }

  .featured-card:hover .featured-title {
    color: var(--color-purple-vibrant);
  }

  .featured-excerpt {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .featured-cta {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 700;
    color: #FDFBFF;
    background: linear-gradient(135deg, #9B4DCA, #C77DFF);
    padding: 0.625rem 1.375rem;
    border-radius: 0.5rem;
    flex-shrink: 0;
    white-space: nowrap;
    transition: box-shadow 0.2s;
  }

  .featured-card:hover .featured-cta {
    box-shadow: 0 0 20px rgba(199,125,255,0.4);
  }

  /* ── Grid ── */
  .posts-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 520px) {
    .posts-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1100px) {
    .posts-grid { grid-template-columns: repeat(3, 1fr); }
  }

  /* ── Índice derecho ── */
  .blog-index {
    display: none;
  }

  @media (min-width: 900px) {
    .blog-index {
      display: block;
      width: 256px;
      flex-shrink: 0;
      position: sticky;
      top: 56px;
      max-height: calc(100vh - 56px);
      overflow-y: auto;
      border-left: 1px solid rgba(199, 125, 255, 0.18);
      background: #FAF7FE;
      scrollbar-width: thin;
      scrollbar-color: rgba(199,125,255,0.18) transparent;
    }
  }

  @media (min-width: 1200px) {
    .blog-index { width: 280px; }
  }

  .index-inner {
    padding: 2rem 1.375rem 2.5rem;
  }

  /* Header del índice con ÍNDICE vertical */
  .index-header {
    display: flex;
    align-items: stretch;
    gap: 0.875rem;
    padding-bottom: 1.5rem;
    margin-bottom: 1.75rem;
    border-bottom: 2px solid var(--color-purple-heart);
  }

  .index-label-vertical {
    font-family: var(--font-heading);
    font-style: normal;
    font-weight: 900;
    font-size: 0.5rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-purple-heart);
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    flex-shrink: 0;
    align-self: stretch;
    opacity: 0.8;
  }

  .index-meta {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .index-brand {
    font-family: var(--font-body);
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(107, 91, 123, 0.4);
    line-height: 1;
  }

  .index-tagline {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 1.0625rem;
    color: var(--color-text-deep);
    line-height: 1.25;
  }

  /* Álbum en el índice */
  .index-album {
    margin-bottom: 1.625rem;
  }

  .index-album-header {
    margin-bottom: 0.5rem;
  }

  .index-album-year {
    display: block;
    font-family: var(--font-body);
    font-size: 0.5rem;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(199, 125, 255, 0.65);
    margin-bottom: 0.125rem;
    line-height: 1;
  }

  .index-album-title {
    display: block;
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text-deep);
    line-height: 1.2;
  }

  .index-list {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0 0.375rem;
    border-left: 1px solid rgba(199, 125, 255, 0.2);
  }

  .index-link {
    display: block;
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 0.8125rem;
    color: rgba(26, 10, 46, 0.55);
    text-decoration: none;
    padding: 0.275rem 0.75rem;
    line-height: 1.35;
    position: relative;
    transition: color 0.15s ease, padding-left 0.18s ease;
    cursor: pointer;
  }

  .index-link::before {
    content: '→';
    position: absolute;
    left: 0.25rem;
    font-style: normal;
    opacity: 0;
    color: var(--color-purple-heart);
    transition: opacity 0.15s ease, left 0.18s ease;
    font-size: 0.625rem;
    top: 50%;
    transform: translateY(-50%);
  }

  .index-link:hover {
    color: var(--color-purple-vibrant);
    padding-left: 1.25rem;
  }

  .index-link:hover::before {
    opacity: 1;
    left: 0.5rem;
  }

  .index-footer {
    padding-top: 1.5rem;
    border-top: 1px solid rgba(199, 125, 255, 0.15);
    margin-top: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.5625rem;
    color: rgba(107, 91, 123, 0.4);
    letter-spacing: 0.04em;
    line-height: 1.6;
  }

  /* ── CTA ── */
  .blog-cta {
    background: linear-gradient(135deg, #1A0A2E 0%, #3B1066 100%);
    padding: 5rem 1.5rem;
    position: relative;
    overflow: hidden;
  }

  .blog-cta::before {
    content: '';
    position: absolute;
    top: -30%;
    left: -10%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(199, 125, 255, 0.07) 0%, transparent 70%);
    pointer-events: none;
  }

  .cta-inner {
    max-width: 36rem;
    margin: 0 auto;
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .cta-label {
    font-family: var(--font-accent);
    font-size: 1.125rem;
    color: var(--color-purple-heart);
    margin-bottom: 0.75rem;
  }

  .cta-title {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    color: #FDFBFF;
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .cta-desc {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.7;
    color: rgba(224, 208, 240, 0.65);
    margin-bottom: 2rem;
  }

  .cta-btn {
    display: inline-block;
    background: linear-gradient(135deg, #9B4DCA, #C77DFF);
    color: #FDFBFF;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1rem;
    padding: 0.9rem 2rem;
    border-radius: 0.75rem;
    text-decoration: none;
    transition: box-shadow 0.3s ease, transform 0.3s ease;
    box-shadow: 0 0 24px rgba(199, 125, 255, 0.28);
    cursor: pointer;
  }

  .cta-btn:hover {
    box-shadow: 0 0 40px rgba(199, 125, 255, 0.5);
    transform: translateY(-2px);
  }
</style>
