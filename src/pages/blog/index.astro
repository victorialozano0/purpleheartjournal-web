---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BlogNav from '../../components/BlogNav.astro';
import Footer from '../../components/Footer.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const ERA_SHORT: Record<string, string> = {
  'ARIRANG (2026)':         'ARIRANG 2026',
  'BE (2020)':              'BE 2020',
  'You Never Walk Alone (2017)': 'YNWA 2017',
  'Love Yourself: Tear (2018)': 'LY: Tear 2018',
};
---

<Layout
  title="El diario de una ARMY — Blog | Purple Heart Journal"
  description="Canciones de BTS analizadas como espejos de autoconocimiento. Reflexiones, prompts de journaling y una invitación a escribir lo que sientes."
>
  <BlogNav />

  <!-- Header -->
  <header class="blog-header">
    <div class="header-inner">
      <div class="header-left">
        <p class="header-eyebrow">El diario de una ARMY</p>
        <h1 class="header-title">Canciones que<br /><em>nos enseñan</em><br />a conocernos</h1>
        <p class="header-desc">
          No somos un medio de noticias de BTS. Somos ARMY que escribe lo que siente
          y que encuentra en las canciones el espejo perfecto para hacerlo.
        </p>
      </div>
      <div class="header-right" aria-hidden="true">
        <span class="header-count-num">{posts.length}</span>
        <span class="header-count-label">canciones<br/>analizadas</span>
      </div>
    </div>
  </header>

  <!-- Separador editorial -->
  <div class="section-divider">
    <span class="divider-line"></span>
    <span class="divider-text">— {posts.length} entradas —</span>
    <span class="divider-line"></span>
  </div>

  <!-- Bento Grid -->
  <main class="bento-wrap">
    <div class="bento-grid">
      {posts.map((post, i) => {
        const isWide  = i % 5 === 0;
        const isDark  = isWide;
        const isARI   = post.data.album.includes('ARIRANG');
        const era     = ERA_SHORT[post.data.album] ?? post.data.album.replace(/ \(\d{4}\)$/, '');
        const quote   = post.data.quote ?? '';
        const lines   = quote ? quote.split(' / ') : [];

        return (
          <a
            href={`/blog/${post.id}`}
            class={`bento-card ${isDark ? 'card-dark' : 'card-light'} ${isARI ? 'era-ari' : 'era-cl'}`}
          >
            <span class={`era-pill ${isARI ? 'pill-ari' : 'pill-cl'}`}>{era}</span>

            {isDark ? (
              /* ── Wide / dark card: lírica hero ── */
              <>
                <div class="quote-zone">
                  <span class="big-quote" aria-hidden="true">"</span>
                  <p class="lyric-hero">
                    {lines.length > 0
                      ? lines.map((l, li) => (<>{l}{li < lines.length - 1 && <br />}</>))
                      : post.data.excerpt.slice(0, 90)}
                  </p>
                </div>
                <div class="dark-footer">
                  <div>
                    <p class="dark-song">{post.data.song}</p>
                    <p class="dark-excerpt">{post.data.excerpt}</p>
                  </div>
                  <span class="dark-cta">Leer <span class="arrow">→</span></span>
                </div>
              </>
            ) : (
              /* ── Small / light card: canción hero ── */
              <>
                <h2 class="song-hero">{post.data.song}</h2>
                {lines[0] && (
                  <p class="light-lyric">"{lines[0]}"</p>
                )}
                <p class="light-excerpt">{post.data.excerpt}</p>
                <span class="light-cta">Leer <span class="arrow">→</span></span>
              </>
            )}
          </a>
        );
      })}
    </div>
  </main>

  <!-- CTA -->
  <section class="blog-cta">
    <div class="cta-inner">
      <p class="cta-label">¿Quieres escribir con BTS de fondo?</p>
      <h2 class="cta-title">El journal que habla en nuestro idioma</h2>
      <p class="cta-desc">
        85+ prompts de journaling guiados por 35 canciones de BTS.<br />
        Para ARMY que escribe entre canciones.
      </p>
      <a
        href="https://pay.hotmart.com/P104306248S"
        class="cta-btn"
        target="_blank"
        rel="noopener noreferrer"
      >
        Conoce el journal 💜
      </a>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* ── Header ── */
  .blog-header {
    background: linear-gradient(135deg, #1A0A2E 0%, #3D1278 55%, #9B4DCA 100%);
    padding: 4.5rem 1.5rem 4rem;
    position: relative;
    overflow: hidden;
  }

  .blog-header::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 80% 50%, rgba(199,125,255,0.1) 0%, transparent 60%);
    pointer-events: none;
  }

  .header-inner {
    max-width: 72rem;
    margin: 0 auto;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    position: relative;
    z-index: 1;
  }

  .header-left { flex: 1; }

  .header-eyebrow {
    font-family: var(--font-accent);
    font-size: 0.8125rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-purple-heart);
    margin-bottom: 1.25rem;
  }

  .header-title {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: clamp(2.25rem, 5vw, 4rem);
    line-height: 1.08;
    color: #FDFBFF;
    margin-bottom: 1.5rem;
  }

  .header-desc {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.75;
    color: rgba(224, 208, 240, 0.65);
    max-width: 36rem;
  }

  .header-right {
    display: none;
    flex-direction: column;
    align-items: flex-end;
    flex-shrink: 0;
    padding-bottom: 0.5rem;
  }

  @media (min-width: 600px) { .header-right { display: flex; } }

  .header-count-num {
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 700;
    font-size: clamp(6rem, 14vw, 10rem);
    line-height: 0.9;
    color: rgba(199, 125, 255, 0.13);
    letter-spacing: -0.04em;
    user-select: none;
  }

  .header-count-label {
    font-family: var(--font-body);
    font-size: 0.5625rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(199, 125, 255, 0.35);
    text-align: right;
    line-height: 1.6;
    margin-top: 0.25rem;
  }

  /* ── Separador ── */
  .section-divider {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem 2rem;
    background: #FDFBFF;
    border-bottom: 1px solid var(--color-soft-lilac);
  }

  .divider-line {
    flex: 1;
    height: 1px;
    background: var(--color-soft-lilac);
  }

  .divider-text {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 0.8125rem;
    color: rgba(107, 91, 123, 0.45);
    letter-spacing: 0.06em;
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* ── Bento wrap ── */
  .bento-wrap {
    background: #F3EAFA;
    padding: 2.5rem 1.25rem 5rem;
  }

  @media (min-width: 768px) {
    .bento-wrap { padding: 3rem 2rem 6rem; }
  }

  /* ── Bento grid ── */
  .bento-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.875rem;
    max-width: 72rem;
    margin: 0 auto;
  }

  @media (min-width: 560px) {
    .bento-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    /* Every 5th card (wide) spans 2 cols */
    .bento-card:nth-child(5n+1) {
      grid-column: span 2;
    }
  }

  @media (min-width: 900px) {
    .bento-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .bento-card:nth-child(5n+1) {
      grid-column: span 2;
    }
  }

  /* ── Base card ── */
  .bento-card {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: 1.25rem;
    padding: 1.625rem 1.5rem 1.375rem;
    text-decoration: none;
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    min-height: 220px;
  }

  .bento-card:hover {
    transform: translateY(-4px);
  }

  /* ── Dark card (wide, every 5th) ── */
  .card-dark {
    background: linear-gradient(140deg, #1A0A2E 0%, #3B1066 60%, #6B2FA0 100%);
    box-shadow: 0 4px 24px rgba(26, 10, 46, 0.3);
    min-height: 280px;
  }

  .card-dark::before {
    content: '';
    position: absolute;
    bottom: -15%;
    right: -5%;
    width: 260px;
    height: 260px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(199,125,255,0.18) 0%, transparent 70%);
    pointer-events: none;
  }

  .card-dark:hover {
    box-shadow: 0 12px 48px rgba(107, 47, 160, 0.5);
  }

  /* ── Light card ── */
  .card-light {
    background: #FDFBFF;
    border: 1px solid var(--color-soft-lilac);
    box-shadow: 0 2px 8px rgba(107, 91, 123, 0.06);
  }

  .card-light.era-ari {
    border-top: 3px solid #C77DFF;
  }

  .card-light.era-cl {
    border-top: 3px solid #9B4DCA;
  }

  .card-light:hover {
    box-shadow: 0 10px 36px rgba(199, 125, 255, 0.18);
    border-color: rgba(199, 125, 255, 0.4);
  }

  /* ── Era pill ── */
  .era-pill {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.5rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    align-self: flex-start;
    margin-bottom: 1.125rem;
    flex-shrink: 0;
  }

  .pill-ari {
    background: rgba(199, 125, 255, 0.18);
    color: #C77DFF;
    border: 1px solid rgba(199, 125, 255, 0.35);
  }

  .pill-cl {
    background: rgba(155, 77, 202, 0.1);
    color: #9B4DCA;
    border: 1px solid rgba(155, 77, 202, 0.25);
  }

  .card-dark .pill-ari,
  .card-dark .pill-cl {
    background: rgba(199, 125, 255, 0.15);
    color: rgba(199, 125, 255, 0.9);
    border-color: rgba(199, 125, 255, 0.3);
  }

  /* ── Dark card: quote zone ── */
  .quote-zone {
    flex: 1;
    position: relative;
    z-index: 1;
  }

  .big-quote {
    display: block;
    font-family: var(--font-heading);
    font-size: 4rem;
    line-height: 0.45;
    color: rgba(199, 125, 255, 0.25);
    margin-bottom: 0.5rem;
    user-select: none;
  }

  .lyric-hero {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    line-height: 1.45;
    color: #FDFBFF;
    letter-spacing: -0.01em;
  }

  /* ── Dark card: footer zone ── */
  .dark-footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.5rem;
    position: relative;
    z-index: 1;
    padding-top: 1rem;
    border-top: 1px solid rgba(199, 125, 255, 0.15);
  }

  .dark-song {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 1rem;
    font-weight: 600;
    color: #C77DFF;
    margin-bottom: 0.25rem;
    line-height: 1.2;
  }

  .dark-excerpt {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    line-height: 1.6;
    color: rgba(224, 208, 240, 0.5);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    max-width: 36rem;
  }

  .dark-cta {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    color: rgba(199, 125, 255, 0.6);
    white-space: nowrap;
    flex-shrink: 0;
    transition: color 0.2s ease;
  }

  .card-dark:hover .dark-cta {
    color: #C77DFF;
  }

  /* ── Light card: song hero ── */
  .song-hero {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.1;
    color: var(--color-text-deep);
    margin-bottom: 0.625rem;
    transition: color 0.2s ease;
  }

  .card-light:hover .song-hero {
    color: var(--color-purple-vibrant);
  }

  /* ── Light card: lyric line ── */
  .light-lyric {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 0.875rem;
    line-height: 1.5;
    color: rgba(107, 91, 123, 0.5);
    margin-bottom: 0.75rem;
    transition: color 0.2s ease;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-light:hover .light-lyric {
    color: rgba(155, 77, 202, 0.65);
  }

  /* ── Light card: excerpt ── */
  .light-excerpt {
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }

  /* ── Light card: cta ── */
  .light-cta {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    color: rgba(107, 91, 123, 0.4);
    margin-top: 1rem;
    transition: color 0.2s ease;
    align-self: flex-end;
  }

  .card-light:hover .light-cta {
    color: var(--color-purple-vibrant);
  }

  /* ── Arrow ── */
  .arrow {
    display: inline-block;
    transition: transform 0.2s ease;
  }

  .bento-card:hover .arrow {
    transform: translateX(4px);
  }

  /* ── CTA ── */
  .blog-cta {
    background: linear-gradient(135deg, #1A0A2E 0%, #3B1066 100%);
    padding: 5rem 1.5rem;
    position: relative;
    overflow: hidden;
  }

  .blog-cta::before {
    content: '';
    position: absolute;
    top: -30%;
    left: -10%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(199, 125, 255, 0.07) 0%, transparent 70%);
    pointer-events: none;
  }

  .cta-inner {
    max-width: 36rem;
    margin: 0 auto;
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .cta-label {
    font-family: var(--font-accent);
    font-size: 1.125rem;
    color: var(--color-purple-heart);
    margin-bottom: 0.75rem;
  }

  .cta-title {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    color: #FDFBFF;
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .cta-desc {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.7;
    color: rgba(224, 208, 240, 0.65);
    margin-bottom: 2rem;
  }

  .cta-btn {
    display: inline-block;
    background: linear-gradient(135deg, #9B4DCA, #C77DFF);
    color: #FDFBFF;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1rem;
    padding: 0.9rem 2rem;
    border-radius: 0.75rem;
    text-decoration: none;
    transition: box-shadow 0.3s ease, transform 0.3s ease;
    box-shadow: 0 0 24px rgba(199, 125, 255, 0.28);
    cursor: pointer;
  }

  .cta-btn:hover {
    box-shadow: 0 0 40px rgba(199, 125, 255, 0.5);
    transform: translateY(-2px);
  }
</style>
