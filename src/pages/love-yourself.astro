---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Problem from '../components/Problem.astro';
import Preview from '../components/Preview.astro';
import Solution from '../components/Solution.astro';
import Features from '../components/Features.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import CtaFinal from '../components/CtaFinal.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <main>
    <Hero />
    <Problem />
    <Preview />
    <Solution />
    <Features />

    <!-- Visual divider: wordplay LY -->
    <section class="ly-wordplay-section">
      <div class="ly-wordplay-inner">
        <div class="ly-line"><span class="ly-accent">BE</span><span class="ly-dark">LIEVE IN</span></div>
        <div class="ly-line"><span class="ly-accent">YOU</span><span class="ly-dark">RSELF.</span></div>
      </div>
    </section>

    <Testimonials />
    <Faq />
    <CtaFinal />
  </main>
  <Footer />
</Layout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Anton&display=swap');

  .ly-wordplay-section {
    background: #F3EAFA;
    padding: 3rem 1.5rem;
    overflow: hidden;
  }
  .ly-wordplay-inner {
    max-width: 900px;
    margin: 0 auto;
    text-align: left;
    line-height: 0.92;
  }
  .ly-line {
    display: block;
    font-family: 'Anton', Impact, sans-serif;
    font-size: clamp(3rem, 14vw, 8rem);
    letter-spacing: 0.01em;
    white-space: nowrap;
  }
  .ly-accent { color: #C77DFF; }
  .ly-dark   { color: #1A0A2E; }
</style>
