---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Problem from '../components/Problem.astro';
import Preview from '../components/Preview.astro';
import Solution from '../components/Solution.astro';
import Features from '../components/Features.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import CtaFinal from '../components/CtaFinal.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <main>
    <Hero />
    <Problem />
    <Preview />
    <Solution />
    <Features />

    <!-- Visual divider: wordplay LY -->
    <section class="bg-lavender-mist py-10 md:py-14">
      <div class="max-w-lg mx-auto text-center px-6">
        <p class="font-accent text-xs tracking-[0.3em] uppercase text-purple-heart/60 mb-3">Era Love Yourself</p>
        <div class="wordplay-block">
          <span class="wordplay-accent">BE</span><span class="wordplay-dark">LOVED.</span>
        </div>
        <p class="font-heading italic text-base md:text-lg text-text-muted mt-4">
          Ya lo eres. Solo tienes que escribirlo.
        </p>
      </div>
    </section>

    <Testimonials />
    <Faq />
    <CtaFinal />
  </main>
  <Footer />
</Layout>
