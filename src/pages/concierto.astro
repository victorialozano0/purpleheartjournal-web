---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';

const leadMagnetEndpoint = import.meta.env.PUBLIC_LEAD_MAGNET_URL || '';
const syUrl = '/speak-yourself';
---

<Layout
  title="Diario ARMY después del concierto · Tour ARIRANG 2026"
  description="Diario gratuito para ARMY que vivió el Tour ARIRANG 2026 de BTS, en el estadio o desde casa. Para escribir lo que te dejó el concierto antes de que el tiempo lo vuelva genérico. PDF descarga directa."
>
  <main>

    <!-- ─── SCHEMA MARKUP SEO ──────────────────────────────────────────── -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Product",
      "name": "Después de todo — Diario post-concierto ARIRANG",
      "description": "Mini journal gratuito para ARMY que vivió el BTS World Tour ARIRANG 2026, en el estadio o desde casa.",
      "brand": { "@type": "Brand", "name": "Purple Heart Journal" },
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD", "availability": "https://schema.org/InStock" },
      "audience": { "@type": "Audience", "audienceType": "ARMY (fans de BTS)" },
      "inLanguage": "es"
    })} />

    <!-- ─── HERO ────────────────────────────────────────────────────────── -->
    <section class="arirang-hero section-padding text-center overflow-hidden relative">
      <div class="absolute inset-0 pointer-events-none">
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] rounded-full bg-arirang/10 blur-[100px]"></div>
      </div>
      <div class="relative z-10 max-w-3xl mx-auto">
        <!-- Three circles motif -->
        <div class="flex justify-center gap-3 mb-5" aria-hidden="true">
          <div class="arirang-circle"></div>
          <div class="arirang-circle"></div>
          <div class="arirang-circle"></div>
        </div>
        <p class="font-accent text-sm tracking-[0.25em] uppercase text-arirang mb-3">BTS World Tour ARIRANG 2026</p>
        <h1 class="font-heading italic text-4xl md:text-5xl lg:text-6xl text-hanji-text leading-[1.1] mb-5">
          Ya pasó el concierto.<br/>
          <span class="text-arirang">Escribe lo que te dejó.</span>
        </h1>
        <p class="font-body text-base md:text-lg text-hanji-soft max-w-2xl mx-auto leading-relaxed mb-4">
          Un mini journal gratuito para que el concierto no se quede solo en un recuerdo que se desvanece.
          Para la que estuvo en el estadio y para la que lo vivió desde casa.
        </p>
        <p class="font-body text-sm text-hanji-soft/80 mb-8">
          PDF · Descarga directa · Sin contraseña
        </p>
        <a href="#diarios" class="btn-arirang-primary">
          Quiero el diario gratis →
        </a>
      </div>
    </section>

    <!-- ─── POR QUÉ ESTOS DIARIOS ──────────────────────────────────────── -->
    <section class="bg-hanji section-padding">
      <div class="max-w-3xl mx-auto">
        <p class="font-accent text-xs tracking-[0.2em] uppercase text-arirang text-center mb-4">Por qué existen</p>
        <h2 class="font-heading italic text-3xl md:text-4xl text-hanji-text text-center leading-tight mb-10">
          El concierto duró tres horas.<br/>Lo que sientes, mucho más.
        </h2>
        <div class="grid md:grid-cols-3 gap-6">
          <div class="arirang-reason-card">
            <div class="arirang-reason-number">01</div>
            <h3 class="font-body font-semibold text-hanji-text mb-2">La espera fue real</h3>
            <p class="font-body text-sm text-hanji-soft leading-relaxed">
              Cuatro años. Servicio militar. Entradas agotadas en minutos. Y por fin pasó.
              Todo eso merece un espacio donde nombrarse.
            </p>
          </div>
          <div class="arirang-reason-card">
            <div class="arirang-reason-number">02</div>
            <h3 class="font-body font-semibold text-hanji-text mb-2">El concert high se apaga</h3>
            <p class="font-body text-sm text-hanji-soft leading-relaxed">
              Esa mezcla de euforia, surrealismo y vacío se va borrando.
              Lo que no escribes, el tiempo lo vuelve genérico.
            </p>
          </div>
          <div class="arirang-reason-card">
            <div class="arirang-reason-number">03</div>
            <h3 class="font-body font-semibold text-hanji-text mb-2">BTS pregunta. Tú respondes.</h3>
            <p class="font-body text-sm text-hanji-soft leading-relaxed">
              ARIRANG tiene 3.600 versiones porque cada persona la hizo suya.
              Este diario es para que escribas la tuya.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ─── DIARIO + FORMULARIO ──────────────────────────────── -->
    <section id="diarios" class="bg-white-glow section-padding">
      <div class="max-w-4xl mx-auto">
        <p class="font-accent text-xs tracking-[0.2em] uppercase text-arirang text-center mb-4">Gratis · Descarga inmediata</p>
        <h2 class="font-heading italic text-3xl md:text-4xl text-hanji-text text-center leading-tight mb-3">
          Un diario. Un solo email.
        </h2>
        <p class="font-body text-sm text-hanji-soft text-center mb-10">
          Te lo enviamos al momento. Lo usas cuando quieras volver a esa noche.
        </p>

        <!-- Journal card -->
        <div class="max-w-xl mx-auto mb-10">
          <div class="arirang-journal-card border-arirang-dark">
            <div class="arirang-journal-badge bg-arirang-dark text-white">Gratis</div>
            <h3 class="font-heading italic text-2xl text-hanji-text mb-2 mt-4">Después de todo</h3>
            <p class="font-accent text-xs tracking-widest uppercase text-arirang-dark mb-4">Para después del concierto</p>
            <ul class="arirang-feature-list mb-4">
              <li>Lo que todavía guardas: los detalles que el tiempo aún no se llevó</li>
              <li>El momento exacto que fue solo tuyo, con todos los sentidos</li>
              <li>El océano púrpura: lo que se siente pertenecer con 80.000 personas</li>
              <li>¿Quién eres tú después de haberlos visto?</li>
            </ul>
            <p class="font-body text-xs text-hanji-soft">20 páginas · Anclado en Body to Body, Into the Sun y Hooligan</p>
          </div>
        </div>

        <!-- Email form -->
        <div class="arirang-form-wrapper">
          <p class="font-heading italic text-xl text-hanji-text text-center mb-2">
            Déjanos tu email y te lo enviamos ahora.
          </p>
          <p class="font-body text-sm text-hanji-soft text-center mb-6">
            También te avisamos cuando haya contenido nuevo sobre la era ARIRANG.
          </p>

          <form id="arirang-form" class="flex flex-col sm:flex-row gap-3 max-w-lg mx-auto" data-endpoint={leadMagnetEndpoint} novalidate>
            <input
              type="email"
              name="email"
              placeholder="tu@email.com"
              required
              autocomplete="email"
              class="arirang-email-input flex-1"
              aria-label="Tu dirección de email"
            />
            <button type="submit" class="btn-arirang-primary whitespace-nowrap" id="arirang-submit">
              Enviarme el PDF →
            </button>
          </form>

          <p id="arirang-error" class="text-red-600 text-sm text-center mt-3 hidden" role="alert"></p>
          <p class="font-body text-xs text-hanji-soft/70 text-center mt-4">
            Sin spam. Puedes darte de baja cuando quieras.
          </p>
        </div>

        <!-- Success message (hidden) -->
        <div id="arirang-success" class="arirang-success hidden text-center">
          <div class="flex justify-center gap-3 mb-4" aria-hidden="true">
            <div class="arirang-circle-sm"></div>
            <div class="arirang-circle-sm"></div>
            <div class="arirang-circle-sm"></div>
          </div>
          <h3 class="font-heading italic text-2xl text-hanji-text mb-2">¡Revisa tu email!</h3>
          <p class="font-body text-hanji-soft leading-relaxed">
            Te enviamos el diario ahora mismo.<br/>
            En 3 días te escribimos de nuevo para ver cómo va el proceso.
          </p>
        </div>
      </div>
    </section>

    <!-- ─── PARA QUIEN NO VA AL CONCIERTO ─────────────────────────────── -->
    <section class="bg-hanji section-padding">
      <div class="max-w-2xl mx-auto text-center">
        <p class="font-accent text-xs tracking-[0.2em] uppercase text-arirang mb-4">También para ti</p>
        <h2 class="font-heading italic text-2xl md:text-3xl text-hanji-text leading-tight mb-5">
          ¿No fuiste al concierto<br/>pero sí viviste la era?
        </h2>
        <p class="font-body text-base text-hanji-soft leading-relaxed mb-6">
          Este diario no es solo para quienes estuvieron en el estadio.
          Si seguiste el tour desde casa, desde un stream, desde el lado de las que
          no pudieron conseguir entrada — tu experiencia también merece nombrarse.
        </p>
        <blockquote class="arirang-quote">
          <p class="font-heading italic text-lg text-hanji-text leading-relaxed mb-2">
            "Para las que los siguieron desde un stream, desde casa, desde la otra orilla del mundo: esta experiencia también es tuya."
          </p>
          <cite class="font-body text-sm text-arirang not-italic">— Del diario, página de introducción</cite>
        </blockquote>
        <p class="font-body text-sm text-hanji-soft mt-6">
          El diario habla también a las ARMY que vivieron el tour desde casa o desde un stream.
        </p>
      </div>
    </section>

    <!-- ─── TESTIMONIO / PULLQUOTE ─────────────────────────────────────── -->
    <section class="bg-white-glow section-padding">
      <div class="max-w-2xl mx-auto text-center">
        <div class="flex justify-center gap-3 mb-6" aria-hidden="true">
          <div class="arirang-circle-sm"></div>
          <div class="arirang-circle-sm"></div>
          <div class="arirang-circle-sm"></div>
        </div>
        <blockquote class="font-heading italic text-2xl md:text-3xl text-hanji-text leading-tight mb-4">
          "Es como llegar a casa después de un vuelo larguísimo."
        </blockquote>
        <p class="font-body text-sm text-hanji-soft mb-2">
          Así describen las ARMY asistir a un concierto de BTS.
        </p>
        <p class="font-body text-sm text-hanji-soft">
          Este diario es para que el viaje de vuelta tenga su propio mapa.
        </p>
      </div>
    </section>

    <!-- ─── FAQ ────────────────────────────────────────────────────────── -->
    <section class="bg-hanji section-padding">
      <div class="max-w-2xl mx-auto">
        <h2 class="font-heading italic text-3xl text-hanji-text text-center mb-10">Preguntas frecuentes</h2>
        <div class="space-y-6">
          {[
            {
              q: '¿Es completamente gratis?',
              a: 'Sí. El PDF es gratuito. Solo necesitas dejar tu email y te lo enviamos de inmediato.'
            },
            {
              q: '¿Sirve si el concierto fue hace semanas?',
              a: 'Sí. Está pensado para volver a esa noche cuando quieras: los ejercicios rescatan lo que todavía guardas, aunque haya pasado tiempo.'
            },
            {
              q: '¿Puedo usarlo si no fui al concierto en persona?',
              a: 'Completamente. El diario tiene ejercicios para ARMY que vivió el tour desde casa, desde un stream o desde la distancia. Tu experiencia también cuenta.'
            },
            {
              q: '¿En qué formato está el PDF?',
              a: 'PDF A5, optimizado para imprimir o llenar digitalmente en GoodNotes, Notability o cualquier app de notas. Sin contraseña, descarga directa.'
            },
            {
              q: '¿Qué pasa después de descargarlo?',
              a: 'En 3 días te escribimos para ver cómo va. En 7 días te contamos sobre el Speak Yourself Journal — el journal completo de la era ARIRANG, con 184 páginas.'
            },
          ].map(({ q, a }) => (
            <div class="arirang-faq-item">
              <h3 class="font-body font-semibold text-hanji-text mb-2">{q}</h3>
              <p class="font-body text-sm text-hanji-soft leading-relaxed">{a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ─── CTA FINAL ───────────────────────────────────────────────────── -->
    <section class="arirang-cta-final section-padding text-center">
      <div class="max-w-2xl mx-auto">
        <div class="flex justify-center gap-3 mb-6" aria-hidden="true">
          <div class="arirang-circle-lg"></div>
          <div class="arirang-circle-lg"></div>
          <div class="arirang-circle-lg"></div>
        </div>
        <h2 class="font-heading italic text-3xl md:text-4xl text-hanji-cream leading-tight mb-4">
          El concierto fue una noche.<br/>
          Lo que escribes dura para siempre.
        </h2>
        <p class="font-body text-hanji-cream/80 mb-8 leading-relaxed">
          Un mini journal. Descarga gratis. Para ARMY que escribe entre canciones.
        </p>
        <a href="#diarios" class="btn-arirang-white">
          Quiero el diario →
        </a>
      </div>
    </section>

    <!-- ─── LINK AL JOURNAL COMPLETO ───────────────────────────────────── -->
    <section class="bg-hanji section-padding text-center">
      <div class="max-w-xl mx-auto">
        <p class="font-body text-sm text-hanji-soft mb-2">¿Quieres más de la era ARIRANG?</p>
        <a href={syUrl} class="font-heading italic text-xl text-arirang hover:text-arirang-dark transition-colors underline underline-offset-4">
          Speak Yourself Journal — 184 páginas →
        </a>
        <p class="font-body text-xs text-hanji-soft/70 mt-2">7 capítulos · 80+ ejercicios · 14 canciones ARIRANG</p>
      </div>
    </section>

    <Footer />
  </main>
</Layout>

<!-- ─── ESTILOS ARIRANG ─────────────────────────────────────────────────── -->
<style>
  /* Paleta ARIRANG */
  :root {
    --arirang:       #FF1340;
    --arirang-dark:  #CC0F32;
    --hanji:         #FDF6EE;
    --hanji-text:    #140608;
    --hanji-soft:    #5C3840;
    --hanji-cream:   #FDF6EE;
  }

  .text-arirang        { color: var(--arirang); }
  .text-arirang-dark   { color: var(--arirang-dark); }
  .text-hanji-text     { color: var(--hanji-text); }
  .text-hanji-soft     { color: var(--hanji-soft); }
  .text-hanji-cream    { color: var(--hanji-cream); }
  .bg-hanji            { background-color: var(--hanji); }
  .bg-arirang          { background-color: var(--arirang); }
  .bg-arirang-dark     { background-color: var(--arirang-dark); }
  .border-arirang      { border-color: var(--arirang); }
  .border-arirang-dark { border-color: var(--arirang-dark); }

  /* Hero */
  .arirang-hero {
    background: linear-gradient(135deg, #FDF6EE 0%, #FDFAF5 60%, #FFF5F7 100%);
    min-height: 88vh;
    display: flex;
    align-items: center;
  }

  /* Three circles */
  .arirang-circle {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 3px solid var(--arirang);
  }
  .arirang-circle-sm {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 2px solid var(--arirang);
  }
  .arirang-circle-lg {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 2.5px solid #FDF6EE;
  }

  /* Buttons */
  .btn-arirang-primary {
    display: inline-block;
    background: var(--arirang);
    color: white;
    padding: 14px 32px;
    border-radius: 10px;
    font-family: var(--font-body, 'DM Sans', Arial, sans-serif);
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
    transition: background 0.2s;
    cursor: pointer;
  }
  .btn-arirang-primary:hover { background: var(--arirang-dark); }

  .btn-arirang-white {
    display: inline-block;
    background: white;
    color: var(--arirang);
    padding: 14px 32px;
    border-radius: 10px;
    font-family: var(--font-body, 'DM Sans', Arial, sans-serif);
    font-weight: 700;
    font-size: 15px;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .btn-arirang-white:hover { opacity: 0.9; }

  /* Reason cards */
  .arirang-reason-card {
    background: white;
    border-radius: 12px;
    padding: 24px;
    border-top: 4px solid var(--arirang);
  }
  .arirang-reason-number {
    font-family: var(--font-heading, 'Cormorant Garamond', serif);
    font-size: 36px;
    font-style: italic;
    color: var(--arirang);
    opacity: 0.25;
    line-height: 1;
    margin-bottom: 8px;
  }

  /* Journal cards */
  .arirang-journal-card {
    background: white;
    border-radius: 12px;
    border: 2px solid;
    padding: 28px;
    position: relative;
  }
  .arirang-journal-badge {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .arirang-feature-list {
    list-style: none;
    padding: 0;
    margin: 0;
    space-y: 8px;
  }
  .arirang-feature-list li {
    font-family: var(--font-body, 'DM Sans', Arial, sans-serif);
    font-size: 13px;
    color: var(--hanji-soft);
    padding: 6px 0 6px 18px;
    border-bottom: 1px solid #F5EAD8;
    position: relative;
    line-height: 1.5;
  }
  .arirang-feature-list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--arirang);
    font-size: 11px;
  }

  /* Form wrapper */
  .arirang-form-wrapper {
    background: var(--hanji);
    border-radius: 16px;
    padding: 36px;
    border: 1px solid #F5EAD8;
  }
  .arirang-email-input {
    padding: 14px 18px;
    border: 2px solid #E5D5C5;
    border-radius: 10px;
    font-size: 15px;
    background: white;
    color: var(--hanji-text);
    outline: none;
    transition: border-color 0.2s;
    width: 100%;
  }
  .arirang-email-input:focus {
    border-color: var(--arirang);
  }

  /* Success */
  .arirang-success {
    background: white;
    border: 2px solid var(--arirang);
    border-radius: 16px;
    padding: 40px;
    margin-top: 16px;
  }

  /* Quote */
  .arirang-quote {
    background: white;
    border-left: 4px solid var(--arirang);
    border-radius: 0 12px 12px 0;
    padding: 20px 24px;
    text-align: left;
    margin: 0;
  }

  /* FAQ */
  .arirang-faq-item {
    background: white;
    border-radius: 12px;
    padding: 20px 24px;
    border-left: 3px solid var(--arirang);
  }

  /* CTA final */
  .arirang-cta-final {
    background: linear-gradient(135deg, var(--arirang-dark) 0%, #8A0820 100%);
  }
</style>

<!-- ─── FORM SCRIPT ─────────────────────────────────────────────────────── -->
<script>
  const form    = document.getElementById('arirang-form') as HTMLFormElement | null;
  const btn     = document.getElementById('arirang-submit') as HTMLButtonElement | null;
  const errorEl = document.getElementById('arirang-error') as HTMLElement | null;
  const success = document.getElementById('arirang-success') as HTMLElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !btn) return;

    const email    = (form.querySelector('input[name="email"]') as HTMLInputElement)?.value?.trim();
    const endpoint = (form as HTMLFormElement & { dataset: { endpoint: string } }).dataset.endpoint;

    if (!email) return;
    if (!endpoint) {
      if (errorEl) { errorEl.textContent = 'El formulario no está disponible ahora mismo. Escríbenos a hola@loveyourselfjournal.me.'; errorEl.classList.remove('hidden'); }
      return;
    }

    btn.disabled = true;
    btn.textContent = 'Enviando...';
    if (errorEl) errorEl.classList.add('hidden');

    try {
      const res = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, journal: 'arirang' }),
      });

      if (!res.ok) throw new Error('Error del servidor');

      // Show success, hide form
      form.classList.add('hidden');
      success?.classList.remove('hidden');

      // GA4 event
      if (typeof window !== 'undefined' && (window as any).gtag) {
        (window as any).gtag('event', 'lead_magnet_submit', {
          event_category: 'lead_magnet',
          event_label: 'arirang_tour',
        });
      }
    } catch (err) {
      if (errorEl) {
        errorEl.textContent = 'Algo salió mal. Inténtalo de nuevo.';
        errorEl.classList.remove('hidden');
      }
      btn.disabled = false;
      btn.textContent = 'Enviarme el PDF →';
    }
  });
</script>
