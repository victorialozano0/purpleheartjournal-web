---
interface Props {
  slug: string;
  title: string;
  song: string;
  album: string;
  excerpt: string;
  quote?: string;
  date: Date;
  tags: string[];
}

const { slug, title, song, album, excerpt, quote, date, tags } = Astro.props;

const formattedDate = date.toLocaleDateString('es-MX', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

const isARIRANG = album.includes('ARIRANG');
---

<a href={`/blog/${slug}`} class={`blog-card ${isARIRANG ? 'card-arirang' : 'card-ly'}`}>

  {quote && (
    <div class="card-quote-block">
      <span class="quote-mark" aria-hidden="true">"</span>
      <p class="card-quote">{quote}</p>
    </div>
  )}

  <div class="card-body">
    <div class="card-meta">
      <span class="meta-song">{song}</span>
      <span class="meta-sep">·</span>
      <span class="meta-album">{album.replace(/ \(\d{4}\)$/, '')}</span>
    </div>
    <h2 class="card-title">{title}</h2>
    <p class="card-excerpt">{excerpt}</p>
    <div class="card-footer">
      <time class="card-date">{formattedDate}</time>
      <div class="card-tags">
        {tags.filter(t => t !== 'ARIRANG').slice(0, 2).map(tag => (
          <span class="tag">#{tag}</span>
        ))}
      </div>
    </div>
  </div>

</a>

<style>
  .blog-card {
    background: #FDFBFF;
    border: 1px solid var(--color-soft-lilac);
    border-radius: 1rem;
    overflow: hidden;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    cursor: pointer;
    border-top: 3px solid transparent;
  }

  .card-arirang {
    border-top-color: #C77DFF;
  }

  .card-ly {
    border-top-color: #9B4DCA;
  }

  .blog-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(199, 125, 255, 0.16);
    border-color: rgba(199, 125, 255, 0.35);
    border-top-color: #C77DFF;
  }

  /* ── Bloque de lírica ── */
  .card-quote-block {
    padding: 1.5rem 1.5rem 0.75rem;
    position: relative;
  }

  .quote-mark {
    display: block;
    font-family: var(--font-heading);
    font-size: 3.5rem;
    line-height: 0.6;
    color: rgba(199, 125, 255, 0.25);
    margin-bottom: 0.25rem;
    user-select: none;
  }

  .card-quote {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 1.1875rem;
    line-height: 1.45;
    color: var(--color-text-deep);
    transition: color 0.2s ease;
    white-space: pre-line;
  }

  .blog-card:hover .card-quote {
    color: var(--color-purple-vibrant);
  }

  /* ── Cuerpo ── */
  .card-body {
    padding: 0.875rem 1.5rem 1.375rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding-top: 0.25rem;
    border-top: 1px solid rgba(199, 125, 255, 0.18);
  }

  .meta-song {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-purple-vibrant);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 9rem;
  }

  .meta-sep {
    color: rgba(107, 91, 123, 0.35);
    font-size: 0.75rem;
    flex-shrink: 0;
  }

  .meta-album {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(107, 91, 123, 0.5);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .card-title {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 1.0625rem;
    line-height: 1.35;
    color: var(--color-text-deep);
    transition: color 0.2s ease;
  }

  .blog-card:hover .card-title {
    color: var(--color-purple-vibrant);
  }

  .card-excerpt {
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ── Footer ── */
  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.5rem;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(224, 208, 240, 0.45);
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .card-date {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: rgba(107, 91, 123, 0.45);
    white-space: nowrap;
  }

  .card-tags {
    display: flex;
    gap: 0.3rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .tag {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    color: var(--color-purple-vibrant);
    background: rgba(155, 77, 202, 0.07);
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    white-space: nowrap;
  }
</style>
