---
interface Props {
  slug: string;
  title: string;
  song: string;
  album: string;
  excerpt: string;
  date: Date;
  tags: string[];
}

const { slug, title, song, album, excerpt, date, tags } = Astro.props;

const formattedDate = date.toLocaleDateString('es-MX', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const isARIRANG = tags.includes('ARIRANG');
---

<a href={`/blog/${slug}`} class="blog-card group block">

  <!-- Visual banner — tipografía como elemento gráfico -->
  <div class={`card-banner ${isARIRANG ? 'banner-arirang' : 'banner-ly'}`}>
    <span class="banner-song">{song}</span>
    <span class="banner-album">{album}</span>
    <div class="banner-glow" aria-hidden="true"></div>
  </div>

  <!-- Content -->
  <div class="card-body">
    <h2 class="card-title">{title}</h2>
    <p class="card-excerpt">{excerpt}</p>
    <div class="card-footer">
      <time class="card-date">{formattedDate}</time>
      <div class="card-tags">
        {tags.filter(t => t !== 'ARIRANG').slice(0, 2).map(tag => (
          <span class="tag">#{tag}</span>
        ))}
      </div>
    </div>
  </div>

</a>

<style>
  .blog-card {
    background: var(--color-white-glow);
    border: 1px solid var(--color-soft-lilac);
    border-radius: 1rem;
    overflow: hidden;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    transition: all 0.3s ease;
  }

  .blog-card:hover {
    border-color: rgba(199, 125, 255, 0.4);
    box-shadow: 0 10px 35px rgba(199, 125, 255, 0.15);
    transform: translateY(-4px);
  }

  /* ── Banner visual ── */
  .card-banner {
    position: relative;
    padding: 1.5rem 1.5rem 1.25rem;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .banner-arirang {
    background: linear-gradient(135deg, #1A0A2E 0%, #5B2C8E 100%);
  }

  .banner-ly {
    background: linear-gradient(135deg, #3B1066 0%, #9B4DCA 100%);
  }

  .banner-song {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 2rem;
    font-weight: 600;
    line-height: 1;
    color: var(--color-white-glow);
    position: relative;
    z-index: 1;
    transition: opacity 0.2s ease;
  }

  .blog-card:hover .banner-song {
    opacity: 0.9;
  }

  .banner-album {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(199, 125, 255, 0.85);
    position: relative;
    z-index: 1;
  }

  /* Glow orb decorativo */
  .banner-glow {
    position: absolute;
    bottom: -40%;
    right: -10%;
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(199, 125, 255, 0.25) 0%, transparent 70%);
    pointer-events: none;
  }

  /* ── Card body ── */
  .card-body {
    padding: 1.25rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .card-title {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 1.1875rem;
    line-height: 1.3;
    color: var(--color-text-deep);
    transition: color 0.2s ease;
  }

  .blog-card:hover .card-title {
    color: var(--color-purple-vibrant);
  }

  .card-excerpt {
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    flex: 1;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(224, 208, 240, 0.5);
  }

  .card-date {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .card-tags {
    display: flex;
    gap: 0.375rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .tag {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    color: var(--color-purple-vibrant);
    background: rgba(155, 77, 202, 0.08);
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    white-space: nowrap;
  }
</style>
