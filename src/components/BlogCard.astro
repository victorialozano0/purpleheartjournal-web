---
interface Props {
  slug: string;
  title: string;
  song: string;
  album: string;
  excerpt: string;
  quote?: string;
  date: Date;
  tags: string[];
  featured?: boolean;
}

const { slug, title, song, album, excerpt, quote, date, tags, featured = false } = Astro.props;

const formattedDate = date.toLocaleDateString('es-MX', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

const isARIRANG = album.includes('ARIRANG');

// Convierte " / " en saltos de línea reales para variación de altura
const quoteLines = quote?.split(' / ') ?? [];
---

<a href={`/blog/${slug}`} class={`blog-card ${featured ? 'card-featured' : isARIRANG ? 'card-arirang' : 'card-ly'}`}>

  <div class="card-quote-block">
    <span class="quote-mark" aria-hidden="true">"</span>
    {featured ? (
      <p class="card-quote">
        {quoteLines.map((line, i) => (
          <>
            {line}{i < quoteLines.length - 1 && <br />}
          </>
        ))}
      </p>
    ) : (
      <p class="card-quote">
        {quoteLines.map((line, i) => (
          <>
            {line}{i < quoteLines.length - 1 && <br />}
          </>
        ))}
      </p>
    )}
  </div>

  <div class="card-body">
    {featured && <span class="card-new-badge">Nueva entrada</span>}
    <div class="card-meta">
      <span class="meta-song">{song}</span>
      <span class="meta-sep">·</span>
      <span class="meta-album">{album.replace(/ \(\d{4}\)$/, '')}</span>
    </div>
    <h2 class="card-title">{title}</h2>
    <p class="card-excerpt">{excerpt}</p>
    <div class="card-footer">
      <time class="card-date">{formattedDate}</time>
      <div class="card-tags">
        {tags.filter(t => t !== 'ARIRANG').slice(0, 2).map(tag => (
          <span class="tag">#{tag}</span>
        ))}
      </div>
    </div>
  </div>

</a>

<style>
  /* ── Base ── */
  .blog-card {
    background: #FDFBFF;
    border: 1px solid var(--color-soft-lilac);
    border-radius: 1rem;
    overflow: hidden;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    cursor: pointer;
    border-top: 3px solid transparent;
  }

  .card-arirang { border-top-color: #C77DFF; }
  .card-ly      { border-top-color: #9B4DCA; }

  .blog-card:not(.card-featured):hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(199, 125, 255, 0.16);
    border-color: rgba(199, 125, 255, 0.35);
    border-top-color: #C77DFF;
  }

  /* ── Destacada: fondo oscuro ── */
  .card-featured {
    background: linear-gradient(150deg, #1A0A2E 0%, #4A1585 70%, #8B3DBF 100%);
    border: none;
    border-radius: 1rem;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    position: relative;
    overflow: hidden;
  }

  .card-featured::before {
    content: '';
    position: absolute;
    bottom: -20%;
    right: -10%;
    width: 220px;
    height: 220px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(199,125,255,0.2) 0%, transparent 70%);
    pointer-events: none;
  }

  .card-featured:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 48px rgba(199, 125, 255, 0.3);
  }

  /* ── Bloque de lírica ── */
  .card-quote-block {
    padding: 1.375rem 1.5rem 0.625rem;
    position: relative;
  }

  .quote-mark {
    display: block;
    font-family: var(--font-heading);
    font-size: 3rem;
    line-height: 0.55;
    color: rgba(199, 125, 255, 0.22);
    margin-bottom: 0.375rem;
    user-select: none;
  }

  .card-featured .quote-mark {
    color: rgba(199, 125, 255, 0.35);
  }

  .card-quote {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 1.25rem;
    line-height: 1.5;
    color: var(--color-text-deep);
    transition: color 0.2s ease;
  }

  .card-featured .card-quote {
    font-size: 1.5rem;
    color: #FDFBFF;
    line-height: 1.4;
  }

  .blog-card:not(.card-featured):hover .card-quote {
    color: var(--color-purple-vibrant);
  }

  /* ── Cuerpo ── */
  .card-body {
    padding: 0.75rem 1.5rem 1.375rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    flex: 1;
    position: relative;
    z-index: 1;
  }

  /* Badge "Nueva entrada" */
  .card-new-badge {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.5625rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-purple-heart);
    background: rgba(199, 125, 255, 0.15);
    border: 1px solid rgba(199, 125, 255, 0.3);
    padding: 0.175rem 0.5rem;
    border-radius: 999px;
    align-self: flex-start;
    margin-bottom: 0.125rem;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding-top: 0.375rem;
    border-top: 1px solid rgba(199, 125, 255, 0.15);
  }

  .card-featured .card-meta {
    border-top-color: rgba(199, 125, 255, 0.25);
  }

  .meta-song {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-purple-vibrant);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 10rem;
  }

  .card-featured .meta-song { color: #C77DFF; }

  .meta-sep {
    color: rgba(107, 91, 123, 0.35);
    font-size: 0.75rem;
    flex-shrink: 0;
  }

  .card-featured .meta-sep { color: rgba(199, 125, 255, 0.3); }

  .meta-album {
    font-family: var(--font-body);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(107, 91, 123, 0.5);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .card-featured .meta-album { color: rgba(199, 125, 255, 0.5); }

  .card-title {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 1.1875rem;
    line-height: 1.3;
    color: var(--color-text-deep);
    transition: color 0.2s ease;
  }

  .card-featured .card-title { color: rgba(253, 251, 255, 0.9); }

  .blog-card:not(.card-featured):hover .card-title {
    color: var(--color-purple-vibrant);
  }

  .card-excerpt {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-featured .card-excerpt { color: rgba(224, 208, 240, 0.65); }

  /* ── Footer ── */
  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.5rem;
    padding-top: 0.625rem;
    border-top: 1px solid rgba(224, 208, 240, 0.4);
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .card-featured .card-footer { border-top-color: rgba(199, 125, 255, 0.2); }

  .card-date {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: rgba(107, 91, 123, 0.4);
    white-space: nowrap;
  }

  .card-featured .card-date { color: rgba(199, 125, 255, 0.4); }

  .card-tags {
    display: flex;
    gap: 0.3rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .tag {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    color: var(--color-purple-vibrant);
    background: rgba(155, 77, 202, 0.07);
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  .card-featured .tag {
    color: #C77DFF;
    background: rgba(199, 125, 255, 0.12);
  }
</style>
